    "To stream in portrait, enable Settings → Streams → %@ → Portrait." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um im Hochformat zu streamen, aktiviere Einstellungen → Streams → %@ → Hochformat."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "T0 str34m 1n p0rtr41t, 3n4bl3 S3tt1ngs → Str34ms → %@ → P0rtr41t."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para transmitir en vertical, habilite Configuración → Transmisiones → %@ → Retrato."
