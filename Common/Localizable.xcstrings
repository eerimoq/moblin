    "Tap the preview to hide it. Double tap to toggle full screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp auf die Vorschau, um sie auszublenden. Tipp doppelt, um auf den Vollbildmodus umzuschalten."
