        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Найкраща можлива стабільність. Може використовувати bonding. Найгнучкіше налаштування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Độ ổn định tốt nhất có thể. Có thể dùng bonding. Thiết lập linh hoạt nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最好的稳定性。可以使用 bonding。最灵活的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "最佳穩定性。可使用聚合傳輸。最靈活的設定。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "穩定性最佳。可能使用聚合連線。最靈活的設定。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相對比較穩定，允許使用Bonding，設定比較靈活。"
          }
        }
      }
    },
