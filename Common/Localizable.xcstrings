    "Best possible stability. May use bonding. Most flexible setup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestmögliche Stabilität. Kann Bonding verwenden. Flexibelster Aufbau."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "B3st p0ss1bl3 st4b1l1ty. M4y _s3 b0nd1ng. M0st fl3x1bl3 s3t_p."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mejor estabilidad posible. Puede utilizar bonding. Configuración más flexible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paras mahdollinen vakaus. Saattaa käyttää yhteyksien bondausta. Joustavin asennus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meilleure stabilité possible. Peut utiliser le bonding. Configuration la plus flexible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सर्वोत्तम संभव स्थिरता. बॉन्डिंग का उपयोग कर सकते हैं. सबसे लचीला सेटअप."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stabilitas terbaik. Bisa menggunakan bonding. Pengaturan paling fleksibel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilità migliore possibile. Può usare il bonding. Configurazione più flessibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能な限り最高の安定性で、ボンディングを使用する場合があります。最もフレキシブルな設定です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최고의 안정성. 본딩을 사용할 수 있습니다. 가장 유연한 설정."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Best mogelijke stabiliteit. Kan bonding gebruiken. Meest flexibele opstelling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najlepsza możliwa stabilność. Może używać bondingu. Najbardziej elastyczna konfiguracja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melhor estabilidade possível. Pode usar ligação. Configuração mais flexível."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Melhor estabilidade possível. Pode usar colagem. Configuração mais flexível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наилучшая стабильность. Поддерживает бондинг. Самая гибкая настройка."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najlepšia možná stabilita. Môže používať spájanie. Najflexibilnejšie nastavenie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bästa möjliga stabilitet. Kan använda bonding. Flexiblast."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mümkün olan en iyi stabilite. Bonding kullanabilir. En esnek kurulum."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Найкраща стабільність. Може використовувати склеювання. Найбільш гнучка настройка."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sự ổn định tốt nhất có thể. Có thể sử dụng liên kết. Thiết lập linh hoạt nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最好的稳定性。可以使用 bonding。最灵活的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "最好的穩定性。可以使用黏合。最靈活的設定。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "穩定性最佳。可能使用聚合連線。最靈活的設定。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相對比較穩定，允許使用Bonding，設定比較靈活。"
          }
        }
