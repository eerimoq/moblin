    "Make built-in and USB cameras not freeze in background mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorgt dafür, dass integrierte Kameras und USB-Kameras im Hintergrundmodus nicht einfrieren."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M@k3 b_1lt-1n @nd _SB c@m3r@s n0t fr33z3 1n b@ckgr0_nd m0d3."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Evita que las cámaras integradas y USB se congelen en modo segundo plano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmistaa, että sisäänrakennetut ja USB-kamerat eivät jumiudu taustatilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Empêche les caméras intégrées et USB de se figer en mode arrière-plan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बैकग्राउंड मोड में बिल्ट-इन और USB कैमरों को फ़्रीज़ होने से रोकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cegah kamera bawaan dan USB membeku di mode latar belakang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impedisce a fotocamere integrate e USB di bloccarsi in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "バックグラウンドモードで内蔵カメラとUSBカメラがフリーズしないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내장 및 USB 카메라가 백그라운드 모드에서 멈추지 않도록 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voorkom dat ingebouwde en USB-camera's bevriezen in de achtergrondmodus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zapobiega zawieszaniu się wbudowanych i USB kamer w trybie tła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Evita que as câmeras integradas e USB congelem no modo em segundo plano."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Evita que as câmaras integradas e USB congelem em modo de segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите чтобы встроенная и USB-камеры не зависали в фоновом режиме."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
