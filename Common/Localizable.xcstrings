    "Add {heartRate:%@} to a text widget to show heart rate on stream." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge {heartRate:%@} zu einem Textwidget hinzu, um die Herzfrequenz im Stream anzuzeigen."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "4dd {h34rtR4t3:%@} t0 @ t3xt w1dg3t t0 sh0w h3@rt r@t3 0n str3@m."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Agregue {heartRate:%@} a un widget de texto para mostrar la frecuencia cardíaca en la transmisión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää {heartRate:%@} teksti-widgetiin näyttääksesi syke lähetyksessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter {heartRate:%@} à un widget de texte pour afficher la fréquence cardiaque sur le stream."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "धारा पर हृदय गति दिखाने के लिए एक टेक्स्ट {heartRate:%@} हार्ट्रेट} जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tambahkan {heartRate:%@} ke widget teks untuk menampilkan detak jantung pada aliran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
