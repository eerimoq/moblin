        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, vous n'êtes pas autorisé à prendre de capture d’écran, désolé. 😢"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@, आपको स्नैपशॉट लेने की अनुमति नहीं है, क्षमा करें। 😢"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@, Anda tidak diizinkan mengambil snapshot, maaf. 😢"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %@, non puoi fare snapshot, scusa. 😢"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@、スナップショットを撮ることは許可されていません、ごめんなさい。 😢"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "죄송합니다, %@님 스냅샷을 촬영할 권한이 없습니다. 😢"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@, u mag geen snapshots maken, sorry. 😢"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, nie możesz zrobić zrzutu, przepraszam. 😢"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, você não tem permissão para fazer capturas de tela, desculpe. 😢"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@, você não tem permissão para tirar instantâneos, desculpe. 😢"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, ты не можешь сделать снимок 😢"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@, nemáte dovolené robiť snímky, prepáčte. 😢"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, du får inte ta foton, förlåt. 😢"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, anlık görüntü almanıza izin verilmiyor, üzgünüm. 😢"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@, вам не дозволяється робити знімки, вибачте. 😢"
