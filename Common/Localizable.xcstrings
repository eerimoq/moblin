        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos haluat lähettää pystykuvaa, ota käyttöön Asetukset → Lähetykset → %@ → Pystykuva."
          }
        },
        "fr" : {
