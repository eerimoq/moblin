          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronoi palvelimellasi useita lähetyksiä aikakoodien avulla. Aikakoodit ovat UTC-aikavyöhykkeellä ja vaativat H.265/HEVC-kodekin ja SRT(LA) - tai RIST-protokollan käyttämisen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Synchronisez plusieurs streams sur votre serveur grâce aux timecodes. Les timecodes sont en UTC et nécessitent le codec H.265/HEVC et SRT(LA) ou RIST."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "टाइमकोड का उपयोग करके अपने सर्वर पर कई स्ट्रीम सिंक करें। टाइमकोड UTC में होते हैं और इनके लिए H.265/HEVC कोडेक और SRT(LA) या RIST आवश्यक है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sinkronkan beberapa stream di server Anda menggunakan timecode. Timecode menggunakan UTC dan memerlukan codec H.265/HEVC serta SRT(LA) atau RIST."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizza più stream sul server usando i timecode. I timecode sono in UTC e richiedono codec H.265/HEVC e SRT(LA) o RIST."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "タイムコードを使ってサーバー上の複数の配信を同期します。タイムコードはUTCで、H.265/HEVCコーデックとSRT(LA)またはRISTが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타임 코드를 사용하여 서버의 여러 스트림을 동기화합니다. 타임 코드는 UTC이며, H.265/HEVC 코덱 및 SRT(LA) 또는 RIST가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Synchroniseer meerdere streams op je server met timecodes. Timecodes zijn in UTC en vereisen de H.265/HEVC-codec en SRT(LA) of RIST."
          }
        },
        "pl" : {
          "stringUnit" : {
