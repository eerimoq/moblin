            "value" : "縦向きでストリーミングするには、「設定」→「ストリーム」→「%@」→「ポートレート」を有効にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세로 비율로 스트리밍하려면 설정 → 송출 → %@ → 세로 모드를 활성화하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Om in portret te streamen, schakel Instellingen → Streams → %@ → Portret in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby streamować w trybie portretowym, włącz Ustawienia → Streamy → %@ → Tryb portretowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
