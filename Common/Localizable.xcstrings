    "The name of your main scene in OBS. Moblin will periodically try to switch to this scene from your BRB scene if the stream is likely working." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Name deiner Hauptszene in OBS. Moblin wird regelmäßig versuchen, von deiner BRB-Szene zu dieser Szene zu wechseln, wenn der Stream wahrscheinlich funktioniert."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
