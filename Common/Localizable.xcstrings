        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모노 오디오는 출력 채널 1만 사용합니다. 스테레오 오디오는 두 출력 채널을 모두 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
