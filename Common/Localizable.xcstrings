    "Allow other devices on the local network to execute HTTP requests through this proxy. Anyone on the local network can use it, so only enable it on networks you trust." : {
      "comment" : "A description of the local network section of the HTTP proxy settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube anderen Geräten im lokalen Netzwerk, HTTP-Anfragen über diesen Proxy auszuführen. Da jeder im lokalen Netzwerk diesen Proxy nutzen kann, solltest du ihn nur in Netzwerken aktivieren, denen du vertraust."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4ll0w 0th3r d3v1c3s 0n th3 l0c4l n3tw0rk t0 3x3c_t3 HTTP r3q_3sts thr0_gh th1s pr0xy. 4ny0n3 0n th3 l0c4l n3tw0rk c4n _s3 1t, s0 0nly 3n4bl3 1t 0n n3tw0rks y0_ tr_st."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que otros dispositivos de la red local ejecuten solicitudes HTTP a través de este proxy. Cualquiera en la red local puede usarlo, así que actívalo solo en redes de confianza."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Salli muiden paikallisverkon laitteiden suorittaa HTTP-pyyntöjä tämän välityspalvelimen kautta. Kuka tahansa paikallisverkossa voi käyttää sitä, joten ota se käyttöön vain luotetuissa verkoissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Autorise les autres appareils du réseau local à exécuter des requêtes HTTP via ce proxy. Toute personne sur le réseau local peut l'utiliser ; ne l'activez donc que sur des réseaux de confiance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "लोकल नेटवर्क के अन्य डिवाइसों को इस प्रॉक्सी के जरिए HTTP अनुरोध चलाने दें। लोकल नेटवर्क पर कोई भी इसका उपयोग कर सकता है, इसलिए इसे केवल भरोसेमंद नेटवर्क पर ही चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Izinkan perangkat lain di jaringan lokal menjalankan permintaan HTTP melalui proxy ini. Siapa pun di jaringan lokal dapat menggunakannya, jadi aktifkan hanya di jaringan tepercaya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Consenti ad altri dispositivi della rete locale di eseguire richieste HTTP tramite questo proxy. Chiunque sulla rete locale può usarlo, quindi attivalo solo su reti di cui ti fidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ローカルネットワーク上の他のデバイスがこのプロキシ経由でHTTPリクエストを実行できるようにします。ローカルネットワーク上の誰でも使用できるため、信頼できるネットワークでのみ有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "로컬 네트워크의 다른 기기가 이 프록시를 통해 HTTP 요청을 실행하도록 허용합니다. 로컬 네트워크의 누구나 사용할 수 있으므로 신뢰하는 네트워크에서만 활성화하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sta toe dat andere apparaten op het lokale netwerk HTTP-verzoeken uitvoeren via deze proxy. Iedereen op het lokale netwerk kan hem gebruiken, dus schakel dit alleen in op netwerken die je vertrouwt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zezwala innym urządzeniom w sieci lokalnej na wykonywanie żądań HTTP przez to proxy. Każdy w sieci lokalnej może z niego korzystać, więc włączaj je tylko w zaufanych sieciach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que outros dispositivos na rede local executem requisições HTTP por este proxy. Qualquer pessoa na rede local pode usá-lo, então ative apenas em redes confiáveis."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que outros dispositivos na rede local executem pedidos HTTP através deste proxy. Qualquer pessoa na rede local pode usá-lo, por isso ative-o apenas em redes de confiança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Разрешить другим устройствам в локальной сети выполнять HTTP-запросы через этот прокси. Им сможет пользоваться любой в локальной сети, поэтому включайте только в доверенных сетях."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Povoľte iným zariadeniam v lokálnej sieti vykonávať požiadavky HTTP cez tento proxy. Môže ho použiť ktokoľvek v lokálnej sieti, preto ho zapnite iba v dôveryhodných sieťach."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt andra enheter i det lokala nätverket att utföra HTTP-förfrågningar via denna proxy. Alla på det lokala nätverket kan använda det, så aktivera det bara på nätverk du litar på."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yerel ağdaki diğer cihazların bu proxy üzerinden HTTP istekleri yürütmesine izin verin. Yerel ağdaki herkes kullanabilir, bu yüzden yalnızca güvendiğiniz ağlarda etkinleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дозволити іншим пристроям у локальній мережі виконувати HTTP-запити через цей проксі. Ним може користуватися будь-хто в локальній мережі, тому вмикайте лише в довірених мережах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
