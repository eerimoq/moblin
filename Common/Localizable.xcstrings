    "Start a screen capture by long-pressing the record button in iOS Control Center and select Moblin." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte eine Bildschirmaufnahme, indem du im iOS Kontrollzentrum lange auf die Aufnahmetaste drückst und Moblin auswählst."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "St@rt @ scr33n c@pt_r3 by l0ng-pr3ss1ng th3 r3c0rd b_tt0n 1n 10S C0ntr0l C3nt3r @nd s3l3ct M0bl1n."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inicia una captura de pantalla manteniendo pulsado el botón de grabación en el Centro de control de iOS y selecciona Moblin."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloita ruudunkaappaus painamalla pitkään tallennuspainiketta iOS-ohjauskeskuksessa ja valitsemalla Moblin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lancez une capture d'écran en maintenant appuyé le bouton d'enregistrement dans le Centre de contrôle iOS, puis sélectionnez Moblin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOS कंट्रोल सेंटर में रिकॉर्ड बटन को देर तक दबाकर स्क्रीन कैप्चर शुरू करें और Moblin चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mulai tangkapan layar dengan menekan lama tombol rekam di Pusat Kontrol iOS lalu pilih Moblin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia una cattura schermo tenendo premuto il pulsante di registrazione nel Centro di Controllo iOS e scegli Moblin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOSのコントロールセンターで録画ボタンを長押しして画面収録を開始し、Moblinを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 제어 센터에서 '화면 기록' 버튼을 길게 눌러 Moblin을 선택하고 '기록 시작'을 누르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Start een schermopname door lang op de opnameknop in het iOS-bedieningscentrum te drukken en selecteer Moblin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpocznij nagrywanie ekranu, naciskając długo przycisk nagrywania w Centrum sterowania iOS i wybierając Moblin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inicie uma captura de tela pressionando e segurando o botão de gravação na Central de Controle do iOS e selecione Moblin."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inicie uma captura de ecrã premindo sem soltar o botão de gravação no Centro de Controlo do iOS e selecione Moblin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустите \"Запись экрана\" в Центре управления iOS и выберите Moblin (нужно зажать иконку записи экрана)"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spustite snímanie obrazovky dlhým stlačením tlačidla nahrávania v Ovládacom centre iOS a vyberte Moblin."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starta en skärmdump genom att trycka länge på inspelningsknappen i iOS Control Center och välj Moblin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOS Denetim Merkezi'nde kayıt düğmesine uzun basarak ekran yakalamayı başlatın ve Moblin'i seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Розпочніть захоплення екрана, довго натиснувши кнопку запису в Центрі керування iOS, і виберіть Moblin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bắt đầu ghi màn hình bằng cách nhấn giữ nút ghi trong Trung tâm điều khiển iOS và chọn Moblin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按 iOS 控制中心中的录制按钮并选择 Moblin 来开始屏幕捕获。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在 iOS 控制中心長按錄製按鈕開始螢幕擷取，然後選擇 Moblin。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
