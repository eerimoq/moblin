    "H.265/HEVC generally requires less bandwidth for same image quality. RTMP generally only supports H.264/AVC." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC erfordert im Allgemeinen weniger Bandbreite für die gleiche Bildqualität. RTMP unterstützt im Allgemeinen nur H.264/AVC."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/H3VC g3n3r4lly r3q_1r3s l3ss b4ndw1dth f0r s4m3 1m4g3 q_4l1ty. RTMP g3n3r4lly 0nly s_pp0rts H.264/4VC."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC generalmente requiere menos ancho de banda para la misma calidad de imagen. RTMP generalmente solo admite H.264/AVC."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC vaatii yleensä vähemmän kaistanleveyttä samaan kuvanlaatuun. RTMP tukee yleensä vain H.264/AVC:tä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265 / HEVC nécessite généralement moins de bande passante pour la même qualité d'image. RTMP ne prend généralement en charge que H.264 / AVC."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC को आमतौर पर समान छवि गुणवत्ता के लिए कम बैंडविड्थ की आवश्यकता होती है। आरटीएमपी आम तौर पर केवल H.264/AVC का समर्थन करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC umumnya membutuhkan lebih sedikit bandwidth untuk kualitas gambar yang sama. RTMP umumnya hanya mendukung H.264/AVC."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC richiede meno banda a parità di qualità. RTMP di solito supporta solo H.264/AVC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVCは通常、同じ画質に対してより少ない帯域幅が必要です。 RTMPは通常、H.264/AVCのみをサポートします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC는 일반적으로 동일한 화질대비 필요한 대역폭이 적습니다. RTMP는 일반적으로 H.264/AVC만 지원합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC vereist over het algemeen minder bandbreedte voor dezelfde beeldkwaliteit. RTMP ondersteunt meestal alleen H.264/AVC."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC zazwyczaj wymaga mniejszej przepustowości dla tej samej jakości obrazu. RTMP ogólnie obsługuje tylko H.264/AVC."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC geralmente requer menos largura de banda para a mesma qualidade de imagem. O RTMP geralmente suporta apenas H.264/AVC."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC geralmente requer menos largura de banda para a mesma qualidade de imagem. O RTMP geralmente suporta apenas H.264/AVC."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC требует меньшей пропускной способности для того же качества изображения. RTMP обычно поддерживает только H.264/AVC."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC vo všeobecnosti vyžaduje menšiu šírku pásma pre rovnakú kvalitu obrazu. RTMP zvyčajne podporuje iba H.264/AVC."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC kräver i allmänhet mindre bandbredd för samma bildkvalitet. RTMP stöder i allmänhet endast H.264/AVC."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC genellikle aynı görüntü kalitesi için daha az bant genişliği gerektirir. RTMP genellikle sadece H.264/AVC'yi destekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC, як правило, вимагає меншої пропускної здатності для однакової якості зображення. RTMP, як правило, підтримує лише H.264/AVC."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC thường yêu cầu ít băng thông hơn cho cùng một chất lượng hình ảnh. RTMP thường chỉ hỗ trợ H.264/AVC."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC通常只需要更少的带宽就能获得与H.264/AVC相同的图像质量。 RTMP通常仅支持H.264/AVC。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC通常需要更少的帶寬才能獲得相同的圖像質量。 RTMP通常僅支持H.264/AVC。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC通常在相同影像品質下所需的頻寬更低。RTMP通常只支援H.264/AVC。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC用更少流量就能有相對好的畫質，RTMP通常只支援H.264/AVC"
          }
        }
      }
    },
