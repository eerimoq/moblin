    "⚠️ Allow Moblin to access your location in iOS Settings to see the current WiFi network." : {
      "comment" : "A warning message that instructs the user to allow location access in iOS Settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Erlaube Moblin, in den iOS-Einstellungen auf deinen Standort zuzugreifen, um das aktuelle WLAN-Netzwerk anzuzeigen."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ @ll0w M0bl1n t0 @cc3ss y0_r l0c@t10n 1n 10S S3tt1ngs t0 s33 th3 c_rr3nt W1F1 n3tw0rk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ Permite que Moblin acceda a tu ubicación en los Ajustes de iOS para ver la red WiFi actual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ Salli Moblinin käyttää sijaintiasi iOS-asetuksissa nähdäksesi nykyisen WiFi-verkon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ Autorisez Moblin à accéder à votre position dans les Réglages iOS pour voir le réseau WiFi actuel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ मौजूदा WiFi नेटवर्क देखने के लिए iOS सेटिंग्स में Moblin को अपनी लोकेशन तक पहुँचने दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ Izinkan Moblin mengakses lokasi Anda di Pengaturan iOS untuk melihat jaringan WiFi saat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ Consenti a Moblin di accedere alla tua posizione nelle Impostazioni iOS per vedere la rete WiFi attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ 現在のWiFiネットワークを表示するには、iOS設定でMoblinに位置情報へのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ 현재 WiFi 네트워크를 보려면 iOS 설정에서 Moblin의 위치 접근을 허용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ Sta Moblin toe je locatie te gebruiken in de iOS-instellingen om het huidige wifi-netwerk te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ Zezwól Moblin na dostęp do lokalizacji w Ustawieniach iOS, aby zobaczyć bieżącą sieć WiFi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ Permita que o Moblin acesse sua localização nos Ajustes do iOS para ver a rede WiFi atual."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ Permita que o Moblin aceda à sua localização nas Definições do iOS para ver a rede WiFi atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ Разрешите Moblin доступ к геопозиции в настройках iOS, чтобы видеть текущую сеть WiFi."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ Povoľte Moblinu prístup k polohe v nastaveniach iOS, aby ste videli aktuálnu sieť WiFi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Tillåt Moblin att komma åt din plats i iOS-inställningarna för att se det aktuella WiFi-nätverket."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ Mevcut WiFi ağını görmek için iOS Ayarları'nda Moblin'in konumunuza erişmesine izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ Дозвольте Moblin доступ до геолокації в налаштуваннях iOS, щоб бачити поточну мережу WiFi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ Hãy cho phép Moblin truy cập vị trí của bạn trong Cài đặt iOS để xem mạng WiFi hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ 请在 iOS 设置中允许 Moblin 访问你的位置信息，以查看当前 WiFi 网络。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ 請在 iOS 設定中允許 Moblin 存取你的位置，以查看目前的 WiFi 網路。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ 請在 iOS 設定中允許 Moblin 存取你的位置，以查看目前的 WiFi 網路。"
          }
        }
      }
    },
