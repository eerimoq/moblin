            "value" : "Налаштуйте переадресацію портів у маршрутизаторі, щоб пересилати вхідний трафік на OBS."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cấu hình chuyển tiếp cổng trên router để chuyển lưu lượng đến vào OBS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在路由器中配置端口转发以将传入流量转发到 OBS。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在路由器中設定連接埠轉送以將輸入流量轉送至 OBS。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在路由器中設定連接埠轉送以將外部流量轉送至 OBS。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定路由器將該連接埠轉發(Port Forwarding)到OBS。"
          }
        }
      }
    },
    "Configure source name in Settings → Streams → %@ → OBS remote control for Fix button and more." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
