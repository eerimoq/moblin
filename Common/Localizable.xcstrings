    "Widgets in selected scene will be shown on the Moblin device the remote control assistant is connected to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets in der ausgewählten Szene werden auf dem Moblin Gerät angezeigt, mit dem der Fernbedienungsassistent verbunden ist."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "W1dg3ts 1n s3l3ct3d sc3n3 w1ll b3 sh0wn 0n th3 M0bl1n d3v1c3 th3 r3m0t3 c0ntr0l @ss1st@nt 1s c0nn3ct3d t0."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los widgets en la escena seleccionada se mostrarán en el dispositivo Moblin al que está conectado el Asistente de control remoto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valittujen näkymien widgetit näytetään Moblin -laitteessa, johon etähallinnan avustaja on yhdistetty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les widgets de la scène sélectionnés seront affichés sur le l’appareil Moblin auquel l'assistant de contrôle à distance est connecté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "चयनित दृश्य में विजेट्स को MOBLIN डिवाइस पर दिखाया जाएगा जो रिमोट कंट्रोल असिस्टेंट से जुड़ा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Widget dalam adegan yang dipilih akan ditampilkan pada perangkat Moblin yang terhubung dengan asisten remote control."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I widget nella scena selezionata verranno mostrati sul dispositivo Moblin a cui è collegato l'assistente di controllo remoto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "選択したシーンのウィジェットは、リモートコントロールアシスタントが接続されているモブリンデバイスに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 장면의 위젯이 원격 제어 어시스턴트가 연결된 Moblin 기기에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Widgets in geselecteerde scène worden getoond op het Moblin -apparaat waarmee de afstandsbedieningsassistent is verbonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widżety w wybranej scenie zostaną pokazane na urządzeniu Moblin, do którego podłączony jest asystent zdalnego sterowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os widgets na cena selecionada serão mostrados no dispositivo Moblin ao qual o Assistente de Controle Remoto está conectado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os widgets na cena selecionada serão mostrados no dispositivo MOBLIN ao qual o Assistente de Controle Remoto está conectado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виджеты в выбранной сцене будут показаны на устройстве Moblin, к которому подключен помощник дистанционного управления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Widgety vo vybranej scéne sa zobrazia na zariadení Moblin, ku ktorému je pripojený asistent diaľkového ovládača."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets i vald scen kommer att visas på Moblin-enheten fjärrkontrollen är ansluten till."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen sahnedeki widget'lar, uzaktan kontrol asistanının bağlı olduğu Moblin cihazında gösterilecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Віджети у вибраній сцені будуть показані на пристрої Мобліна, до якого підключений асистент дистанційного керування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Các tiện ích trong cảnh được chọn sẽ được hiển thị trên thiết bị Moblin Trợ lý điều khiển từ xa được kết nối."
          }
        },
        "zh-Hans" : {
