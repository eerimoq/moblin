    "Settings that would stop the stream are disabled when live." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen, die den Stream anhalten würden, sind während der Live-Übertragung deaktiviert."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "S3tt1ngs th@t w0_ld st0p th3 str3@m @r3 d1s@bl3d wh3n l1v3."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes que detendrían la transmisión han sido deshabilitados mientras estás en directo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetyksen pysäyttävät asetukset eivät ole käytössä lähetyksen aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages qui interrompraient le stream sont désactivés pendant une diffusion."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्ट्रीम को रोकने वाली सेटिंग्स लाइव होने पर अक्षम कर दी जाती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pengaturan yang akan menghentikan aliran dinonaktifkan saat hidup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni che fermerebbero lo streaming sono disattivate in diretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストリームを停止する設定は、ライブ時に無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방송 중에는 스트림을 중단하는 설정이 비활성화됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instellingen die de stream zouden stoppen, zijn uitgeschakeld wanneer je live bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia, które mogłyby zatrzymać stream są wyłączone podczas transmisji na żywo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As configurações que interromperiam a transmissão serão desativadas durante a transmissão ao vivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As configurações que interromperiam a transmissão serão desativadas durante a transmissão ao vivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Влияющие на стрим настройки отключены во время эфира."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavenia, ktoré by zastavili stream, sú počas živého vysielania vypnuté."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningar som skulle stoppa streamen är inte tillgängliga när man är live."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yayını durduracak ayarlar canlı olduğunda devre dışı bırakılır."
