    "Best possible stability. May use bonding. Most flexible setup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestmögliche Stabilität. Kann Bonding verwenden. Flexibelster Aufbau."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "B3st p0ss1bl3 st4b1l1ty. M4y _s3 b0nd1ng. M0st fl3x1bl3 s3t_p."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mejor estabilidad posible. Puede utilizar bonding. Configuración más flexible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paras mahdollinen vakaus. Saattaa käyttää yhteyksien bondausta. Joustavin asennus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meilleure stabilité possible. Peut utiliser le bonding. Configuration la plus flexible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सर्वोत्तम संभव स्थिरता। बॉन्डिंग का उपयोग हो सकता है। सबसे लचीला सेटअप।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stabilitas terbaik. Bisa memakai bonding. Setup paling fleksibel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilità migliore possibile. Può usare il bonding. Configurazione più flessibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能な限り最高の安定性で、ボンディングを使用する場合があります。最もフレキシブルな設定です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최고의 안정성. 본딩을 사용할 수 있습니다. 가장 유연한 설정."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Best mogelijke stabiliteit. Kan bonding gebruiken. Meest flexibele opzet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najlepsza możliwa stabilność. Może używać bondingu. Najbardziej elastyczna konfiguracja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melhor estabilidade possível. Pode usar ligação. Configuração mais flexível."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Melhor estabilidade possível. Pode usar bonding. Configuração mais flexível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наилучшая стабильность. Поддерживает бондинг. Самая гибкая настройка."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najlepšia možná stabilita. Môže používať spájanie. Najflexibilnejšie nastavenie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bästa möjliga stabilitet. Kan använda bonding. Flexiblast."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mümkün olan en iyi stabilite. Bonding kullanabilir. En esnek kurulum."
