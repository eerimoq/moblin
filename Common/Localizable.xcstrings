        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den totala energiförbrukningen blir högre och bildkvaliteten för livestreamen blir sämre när åsidosättningen är aktiverad, oavsett om du spelar in eller inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geçersiz kılma etkinken, kayıt yapıp yapmadığınızdan bağımsız olarak toplam enerji tüketimi artar ve canlı yayın görüntü kalitesi düşer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Коли перевизначення увімкнено, загальне енергоспоживання буде вищим, а якість зображення прямого ефіру гіршою, незалежно від того, чи ведеться запис."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Khi bật ghi đè, mức tiêu thụ năng lượng tổng thể sẽ cao hơn và chất lượng hình ảnh live stream sẽ kém hơn, bất kể bạn có đang ghi hay không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "启用覆盖后,无论是否正在录制,整体能耗都会更高,直播画质也会更差。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "啟用覆寫後,無論是否正在錄影,整體耗電量都會更高,直播畫質也會更差。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用功能後，無論是否進行錄製，整體能耗都會增加，實況畫面品質也會變差。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當覆寫啟用時，不論是否在錄影，整體耗電會增加，畫質會下跌"
          }
        }
      }
    },
    "The Photo shoot quick button starts and stops the photo shoot instantly, without the scene switch transition. Uses slightly more system resources." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotoaufnahme-Schnelltaste startet und stoppt die Fotoaufnahme sofort, ohne dass ein Szenenwechsel erforderlich ist. Verbraucht etwas mehr Systemressourcen."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Th3 Ph0t0 sh00t q_1ck b_tt0n st@rts @nd st0ps th3 ph0t0 sh00t 1nst@ntly, w1th0_t th3 sc3n3 sw1tch tr@ns1t10n. _s3s sl1ghtly m0r3 syst3m r3s0_rc3s."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El botón rápido de Sesión de fotos inicia y detiene la sesión al instante, sin la transición de cambio de escena. Usa algo más de recursos del sistema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valokuvauksen pikapainike käynnistää ja pysäyttää kuvauksen heti ilman kohtauksenvaihdon siirtymää. Käyttää hieman enemmän järjestelmäresursseja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le bouton rapide Séance photo démarre et arrête la séance instantanément, sans transition de changement de scène. Utilise un peu plus de ressources système."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "फोटो शूट क्विक बटन बिना सीन स्विच ट्रांज़िशन के फोटो शूट को तुरंत शुरू और बंद करता है। सिस्टम संसाधन थोड़े अधिक उपयोग होते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tombol cepat Photo shoot memulai dan menghentikan sesi foto secara instan, tanpa transisi pergantian scene. Menggunakan sedikit lebih banyak sumber daya sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il pulsante rapido Servizio fotografico avvia e ferma il servizio all'istante, senza la transizione di cambio scena. Usa leggermente più risorse di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "フォトシュートのクイックボタンは、シーン切り替えのトランジションなしで、フォトシュートを即座に開始・停止します。システムリソースをやや多く使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "사진 촬영 퀵 버튼은 장면 전환 효과 없이 사진 촬영을 즉시 시작하고 중지합니다. 시스템 리소스를 약간 더 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De snelknop Fotoshoot start en stopt de fotoshoot direct, zonder scèneovergang. Gebruikt iets meer systeembronnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Szybki przycisk sesji zdjęciowej uruchamia i zatrzymuje sesję natychmiast, bez przejścia zmiany sceny. Zużywa nieco więcej zasobów systemowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O botão rápido de Sessão de fotos inicia e para a sessão instantaneamente, sem a transição de troca de cena. Usa um pouco mais de recursos do sistema."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O botão rápido de Sessão fotográfica inicia e para a sessão instantaneamente, sem a transição de mudança de cena. Usa um pouco mais de recursos do sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Быстрая кнопка фотосъёмки мгновенно запускает и останавливает фотосессию без перехода при смене сцены. Использует немного больше системных ресурсов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rýchle tlačidlo Fotenie okamžite spúšťa a zastavuje fotenie bez prechodu pri prepnutí scény. Používa o niečo viac systémových zdrojov."
          }
        },
        "sv" : {
