    "Enable to monitor and control this device from another device using a web browser. There is no authentication, nor encryption, so be careful." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere diese Option, um dieses Gerät von einem anderen Gerät aus mithilfe eines Webbrowsers zu überwachen und zu steuern. Es gibt keine Authentifizierung oder Verschlüsselung, sei also vorsichtig."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "3n@bl3 t0 m0n1t0r @nd c0ntr0l th1s d3v1c3 fr0m @n0th3r d3v1c3 _s1ng @ w3b br0ws3r. Th3r3 1s n0 @_th3nt1c@t10n, n0r 3ncrypt10n, s0 b3 c@r3f_l."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Habilite para monitorear y controlar este dispositivo desde otro dispositivo usando un navegador web. No hay autenticación ni cifrado, así que tenga cuidado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota käyttöön tämän laitteen valvonta ja etäohjaus toiselta laitteelta verkkoselaimen avulla. Todennusta tai salausta ei ole, joten ole varovainen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet de surveiller et de contrôler cet appareil à partir d'un autre appareil à l'aide d'un navigateur Web. Il n'y a pas d'authentification, ni de cryptage, alors soyez prudent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "वेब ब्राउज़र का उपयोग करके किसी अन्य डिवाइस से इस डिवाइस की निगरानी और नियंत्रण करने में सक्षम करें। न तो कोई प्रमाणीकरण है, न ही एन्क्रिप्शन, इसलिए सावधान रहें।"
