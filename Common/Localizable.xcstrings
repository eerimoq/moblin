    "Often bad stability if network connection is unstable. No server side disconnection protection possible." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oft schlechte Stabilität, wenn die Netzwerkverbindung instabil ist. Kein serverseitiger Verbindungsabbruchschutz möglich."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0ft3n b4d st4b1l1ty 1f n3tw0rk c0nn3ct10n 1s _nst4bl3. N0 s3rv3r s1d3 d1sc0nn3ct10n pr0t3ct10n p0ss1bl3."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A menudo, la estabilidad es mala si la conexión de red es inestable. No es posible la protección de desconexión del lado del servidor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usein huono vakaus, jos verkkoyhteys on epävakaa. Yhteyden katkeamissuojaus palvelimelta ei ole mahdollista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Souvent peu stable si la connexion réseau est instable. Aucune protection contre la déconnexion côté serveur possible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नेटवर्क कनेक्शन अस्थिर होने पर अक्सर स्थिरता खराब रहती है। सर्वर साइड पर डिस्कनेक्शन सुरक्षा संभव नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sering kurang stabil jika koneksi jaringan tidak stabil. Perlindungan pemutusan koneksi di sisi server tidak dimungkinkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spesso poco stabile se la rete è instabile. Nessuna protezione dalla disconnessione lato server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク接続が不安定な場合、安定性が低下することがよくあります。サーバー側の切断保護は使用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종종 네트워크 연결이 불안정하면 방송이 원활하지 않습니다. 서버 측 연결 끊김 보호가 불가능합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaak slechte stabiliteit bij een instabiele netwerkverbinding. Geen bescherming tegen verbroken verbinding aan serverzijde mogelijk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Często zła stabilność, jeśli połączenie sieciowe jest niestabilne. Brak możliwości zabezpieczenia przed rozłączeniem po stronie serwera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muitas vezes, a estabilidade é ruim se a conexão de rede estiver instável. Nenhuma proteção de desconexão do lado do servidor é possível."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Frequentemente pouco estável se a ligação de rede for instável. Não é possível proteção contra desconexão do lado do servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чаще нестабильно при плохом соединении. Защита от разрыва на стороне сервера невозможна."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Často slabá stabilita, ak je sieťové pripojenie nestabilné. Ochrana pred odpojením na strane servera nie je možná."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofta dålig stabilitet om nätverksanslutningen är instabil. Inget skydd från serversidan är möjligt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ bağlantısı stabil değilse genellikle düşük stabilizasyon sağlar. Kick yayın kesilme koruması sunmuyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часто погана стабільність, якщо з’єднання з мережею нестабільне. Захист від відключення на стороні сервера неможливий."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
