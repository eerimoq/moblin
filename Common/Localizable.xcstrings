    "Moblin identifies itself to the vehicle with this key. Tap the button below to add it to your vehicle." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit diesem Schlüssel identifiziert sich Moblin gegenüber dem Fahrzeug. Tippe auf die Schaltfläche unten, um es deinem Fahrzeug hinzuzufügen."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "M0bl1n 1d3nt1f13s 1ts3lf t0 th3 v3h1cl3 w1th th1s k3y. T@p th3 b_tt0n b3l0w t0 @dd 1t t0 y0_r v3h1cl3."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moblin se identifica con el vehículo con esta llave. Toque el botón de abajo para agregarla a su vehículo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moblin tunnistaa itsensä ajoneuvolle tällä avaimella. Lisää se ajoneuvoosi napauttamalla alla olevaa painiketta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moblin s'identifie auprès du véhicule avec cette clé. Appuyez sur le bouton ci-dessous pour l'ajouter à votre véhicule."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "मोब्लिन इस कुंजी से वाहन में अपनी पहचान बताता है। इसे अपने वाहन में जोड़ने के लिए नीचे दिए गए बटन पर टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moblin mengidentifikasi dirinya pada kendaraan dengan kunci ini. Ketuk tombol di bawah untuk menambahkannya ke kendaraan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moblin si interfaccia con il veicolo usando questa chiave. Tocca il pulsante qui sotto per aggiungerla al veicolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moblin はこのキーを使用して車両に自身を識別します。車両に追加するには、下のボタンをタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
