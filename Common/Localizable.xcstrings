    "Warning: OBS typically requires hardware decoding not to crash when enabled." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung: OBS erfordert normalerweise Hardware-Dekodierung, um bei Aktivierung nicht abzustürzen."
          }
        },
        "eo" : {
          "stringUnit" : {
