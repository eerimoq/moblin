    "Replace `hevc_videotoolbox` with your preferred encoder, typically a hardware encoder for faster conversion." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetze „hevc_videotoolbox“ durch deinen bevorzugten Encoder, normalerweise einen Hardware-Encoder für eine schnellere Konvertierung."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "R3pl@c3 `h3vc_v1d30t00lb0x` w1th y0_r pr3f3rr3d 3nc0d3r, typ1c@lly @ h@rdw@r3 3nc0d3r f0r f@st3r c0nv3rs10n."
