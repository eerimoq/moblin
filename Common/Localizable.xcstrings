          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System zdaje się działać najlepiej w TMobile. IPv4 prawdopodobnie najlepsze dla IRLToolkit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sistema parece funcionar melhor para TMobile. IPv4 provavelmente é melhor para IRLToolkit."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
