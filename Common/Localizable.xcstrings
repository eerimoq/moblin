    "Enable low light boost to make builtin cameras automatically lower the selected FPS for brighter image when dark (if supported)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere die Low Light Boost-Funktion, damit integrierte Kameras bei Dunkelheit automatisch die ausgewählte FPS verringern, um ein helleres Bild zu erhalten (sofern unterstützt)."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3n@bl3 l0w l1ght b00st t0 m@k3 b_1lt1n c@m3r@s @_t0m@t1c@lly l0w3r th3 s3l3ct3d FPS f0r br1ght3r 1m@g3 wh3n d@rk (1f s_pp0rt3d)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activa el realce con poca luz para que las cámaras integradas reduzcan automáticamente los FPS seleccionados y den una imagen más brillante en la oscuridad (si es compatible)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota matalan valon tehostus käyttöön, jotta sisäänrakennetut kamerat laskevat automaattisesti valittua FPS-arvoa kirkkaamman kuvan saamiseksi pimeässä (jos tuettu)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez l'amplification en basse lumière pour que les caméras intégrées réduisent automatiquement le nombre d’IPS sélectionné pour une image plus lumineuse dans l'obscurité (si supporté)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "लो लाइट बूस्ट चालू करें ताकि बिल्टइन कैमरे अंधेरे में अधिक उज्ज्वल छवि के लिए चुने गए FPS को अपने आप घटा दें (यदि समर्थित हो)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aktifkan low light boost agar kamera bawaan otomatis menurunkan FPS yang dipilih untuk gambar lebih terang saat gelap (jika didukung)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva il boost per la scarsa luce: le fotocamere integrate abbassano gli FPS scelti per un'immagine più luminosa al buio (se supportato)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "低照度ブーストを有効にすると、内蔵カメラが暗い場所で選択したFPSを自動的に下げ、より明るい映像にします(対応している場合)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
