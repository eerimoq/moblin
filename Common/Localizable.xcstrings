    "If enabled, selected LUT is applied when the Apple Log color space is used." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn diese Option aktiviert ist, wird die ausgewählte LUT angewendet, wenn der Apple Log-Farbraum verwendet wird."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1f 3n@bl3d, s3l3ct3d L_T 1s @ppl13d wh3n th3 @ppl3 L0g c0l0r sp@c3 1s _s3d."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está habilitado, el LUT seleccionado se aplica cuando se utiliza el espacio de color Apple Log."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos käytössä, valittua LUT:ta käytetään, kun Apple Log -väriavaruutta käytetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si activé, la LUT sélectionnée est appliquée lorsque l'espace colorimétrique Apple Log est utilisé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सक्षम होने पर, Apple Log कलर स्पेस उपयोग करने पर चुना गया LUT लागू होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jika diaktifkan, LUT yang dipilih diterapkan saat ruang warna Apple Log digunakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivo, la LUT scelta viene applicata con lo spazio colore Apple Log."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、Apple Log カラースペースが使用されるときに、選択した LUT が適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 Apple Log 색 공간을 사용할 때 선택한 LUT가 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Indien ingeschakeld wordt de geselecteerde LUT toegepast wanneer de Apple Log-kleurruimte wordt gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli ta opcja jest włączona, wybrana tabela LUT jest stosowana, gdy używana jest przestrzeń kolorów Apple Log."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ativado, o LUT selecionado será aplicado quando o espaço de cores Apple Log for usado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se ativado, a LUT selecionada é aplicada quando o espaço de cor Apple Log é utilizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включен, выбранный LUT применяется при использовании цветового пространства Apple Log."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je táto možnosť zapnutá, vybraná LUT sa použije pri použití farebného priestoru Apple Log."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om aktiverad appliceras vald LUT när Apple Log-färgrymden används."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirilirse, Apple Log renk alanı kullanıldığında seçilen LUT uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Якщо увімкнено, вибрана LUT застосовується під час використання кольорового простору Apple Log."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nếu bật, LUT đã chọn sẽ được áp dụng khi dùng không gian màu Apple Log."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果启用，则在使用 Apple Log 色彩空间时会应用选定的 LUT。"
