    "Animated emotes are fairly CPU intensive. Disable for less power usage." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animierte Emotes sind ziemlich CPU-intensiv. Deaktivieren für weniger Stromverbrauch."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "4n1m4t3d 3m0t3s 4r3 f41rly CP_ 1nt3ns1v3. D1s4bl3 f0r l3ss p0w3r _s4g3."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los emotes animados consumen bastante CPU. Desactívalos para reducir el uso de energía."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animoidut hymiöt on melko prosessorikuormittavia. Poista käytöstä vähentääksesi virrankulutusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les émotes animées utilisent les ressources CPU de façon intensive. Désactiver pour réduire l'utilisation de la batterie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एनिमेटेड भावनाएं काफी सीपीयू गहन हैं।कम बिजली के उपयोग के लिए अक्षम करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Emosi animasi cukup intensif CPU.Nonaktifkan untuk penggunaan daya yang lebih sedikit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le emote animate usano parecchia CPU. Disattivale per consumare meno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アニメーションエモートはCPUを激しく使います。電力使用量を減らすためには無効にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "애니메이션 이모티콘은 CPU를 상당히 많이 사용합니다. 배터리를 아끼려면 비활성화하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geanimeerde emoties zijn redelijk CPU-intensief. Schakel ze uit voor minder stroomgebruik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animowane emotki mogą przyczynić się do obciążenia CPU. Wyłącz, aby zmniejszyć zużycie energii. "
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emotes animados consomem bastante CPU. Desative para menos consumo de energia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Emotes animados consomem bastante CPU. Desative para menos consumo de energia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анимированные смайлы довольно сильно нагружают процессор. Отключите их для уменьшения энергопотребления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animované emotikony sú pomerne náročné. Zakážte menšie využitie energie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animerade emotes använder mycket CPU. Stäng av dom för mindre energiförbrukning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animasyonlu ifadeler işlemciyi yoğun şekilde kullanır. Daha az güç kullanımı için devre dışı bırakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анімовані емоції досить інтенсивно навантажують процесор. Вимкніть для меншого споживання енергії."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Các emote hoạt hình khá chuyên sâu CPU.Vô hiệu hóa để sử dụng ít năng lượng hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动画表情会大量消耗 CPU 资源，在低性能模式中禁用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
