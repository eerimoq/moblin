    "Moblin identifies itself to the vehicle with this key. Tap the button below to add it to your vehicle." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit diesem Schlüssel identifiziert sich Moblin gegenüber dem Fahrzeug. Tippe auf die Schaltfläche unten, um es deinem Fahrzeug hinzuzufügen."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M0bl1n 1d3nt1f13s 1ts3lf t0 th3 v3h1cl3 w1th th1s k3y. T@p th3 b_tt0n b3l0w t0 @dd 1t t0 y0_r v3h1cl3."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moblin se identifica ante el vehículo con esta clave. Toca el botón de abajo para añadirla a tu vehículo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moblin tunnistaa itsensä ajoneuvolle tällä avaimella. Lisää se ajoneuvoosi napauttamalla alla olevaa painiketta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moblin s'identifie auprès du véhicule avec cette clé. Appuyez sur le bouton ci-dessous pour l'ajouter à votre véhicule."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moblin इस कुंजी से वाहन को अपनी पहचान देता है। इसे अपने वाहन में जोड़ने के लिए नीचे दिए बटन पर टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moblin mengidentifikasi dirinya ke kendaraan dengan kunci ini. Ketuk tombol di bawah untuk menambahkannya ke kendaraan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moblin si interfaccia con il veicolo usando questa chiave. Tocca il pulsante qui sotto per aggiungerla al veicolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moblinはこのキーで車両に自身を識別させます。下のボタンをタップして車両に追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moblin은 이 키로 차량과 자신을 식별합니다. 아래 버튼을 탭하여 차량에 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moblin identificeert zich met deze sleutel bij het voertuig. Tik op de knop hieronder om hem aan je voertuig toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moblin identyfikuje się w pojeździe za pomocą tego klucza. Stuknij przycisk poniżej, aby dodać go do pojazdu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Moblin se identifica com o veículo com esta chave. Toque no botão abaixo para adicioná-lo ao seu veículo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Moblin identifica-se junto do veículo com esta chave. Toque no botão abaixo para a adicionar ao seu veículo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moblin идентифицирует себя в автомобиле с этим ключом. Нажмите кнопку ниже, чтобы добавить его в свой автомобиль."
          }
        },
        "sk" : {
          "stringUnit" : {
