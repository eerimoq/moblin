    "Change camera and restart stream for these to work properly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsel die Kamera und starte den Stream neu, damit diese ordnungsgemäß funktionieren."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ch4ng3 c4m3r4 4nd r3st4rt str34m f0r th3s3 t0 w0rk pr0p3rly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia la cámara y reinicia la transmisión para que funcione correctamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihda kameraa ja käynnistä lähetys uudelleen, jotta nämä toimivat oikein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez de caméra et redémarrez le stream pour que ceux-ci fonctionnent correctement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इन्हें ठीक से काम करने के लिए कैमरा बदलें और स्ट्रीम पुनः प्रारंभ करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ganti kamera dan mulai ulang streaming agar berfungsi dengan baik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia fotocamera e riavvia lo streaming perché funzionino correttamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらが正しく動作するように、カメラを変更してストリームを再起動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제대로 작동하기 위해서 카메라를 변경하고 방송을 다시 시작하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wijzig de camera en start de stream opnieuw, zodat deze goed werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmień kamerę i uruchom ponownie transmisję, aby działały prawidłowo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mude a câmera e reinicie a transmissão para que funcionem corretamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mude a câmera e reinicie a transmissão para que funcionem corretamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменить камеру и перезапусть стрим чтобы они работали правильно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmeňte kameru a reštartujte stream, aby ich fungovali správne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byt kamera och starta om streamen för att dessa ska fungera korrekt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunların düzgün çalışması için kamerayı değiştirin ve yayını yeniden başlatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Змініть камеру та перезапустіть потік, щоб вони працювали належним чином."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Thay đổi camera và khởi động lại luồng để chúng hoạt động bình thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换相机并重启推流以使它们正常工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "更改相機並重新啟動串流以使它們正常工作。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改相機並重新啟動串流以使它們正常運作。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為確保正常運作，請切換鏡頭及重啟直播。"
          }
        }
      }
