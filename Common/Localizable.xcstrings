    "Moblin sends these credentials securely to the paired GoPro over Bluetooth." : {
      "comment" : "A description of how GoPro credentials are shared.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moblin übermittelt diese Anmeldedaten gesichert über Bluetooth an die gekoppelte GoPro."
          }
        },
        "eo" : {
          "stringUnit" : {
