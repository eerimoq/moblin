        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keď je povolené prepísanie, celková spotreba energie bude vyššia a kvalita obrazu živého vysielania horšia, bez ohľadu na to, či nahrávate."
          }
