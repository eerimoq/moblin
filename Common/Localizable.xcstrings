        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पूर्वावलोकन को छिपाने के लिए उस पर टैप करें। पूर्ण स्क्रीन पर टॉगल करने के लिए डबल टैप करें।"
