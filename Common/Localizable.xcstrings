    "Lower FPS generally gives brighter image in low light conditions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedrigere FPS führen bei schlechten Lichtverhältnissen im Allgemeinen zu einem helleren Bild."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L0w3r FPS g3n3r@lly g1v3s br1ght3r 1m@g3 1n l0w l1ght c0nd1t10ns."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un FPS más bajo suele dar una imagen más brillante con poca luz."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matala FPS antaa yleensä kirkkaamman kuvan heikossa valaistuksessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des IPS plus faibles donnent généralement une image plus claire en basse luminosité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कम FPS से आमतौर पर कम रोशनी में तस्वीर ज़्यादा चमकदार आती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FPS lebih rendah umumnya menghasilkan gambar lebih terang saat cahaya redup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un FPS più basso di solito dà un'immagine più luminosa al buio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FPSを下げると、一般的に低照度下で映像が明るくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반적으로 낮은 FPS는 저조도 환경에서 더 밝은 이미지를 제공합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lagere FPS geeft over het algemeen een helderder beeld bij weinig licht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mniejsza liczba klatek na sekundę (FPS) zazwyczaj zapewnia jaśniejszy obraz w warunkach słabego oświetlenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FPS mais baixo geralmente produz imagens mais brilhantes em condições de pouca luz."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "FPS inferior geralmente dá uma imagem mais clara com pouca luz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более низкая частота кадров обеспечивает более яркое изображение в условиях низкой освещенности, видео становится менее плавным."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nižšie FPS zvyčajne poskytuje jasnejší obraz pri slabom osvetlení."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägre FPS ger generellt en ljusare bild i svagt ljus."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düşük FPS genellikle düşük ışık koşullarında daha parlak görüntü verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нижчий FPS зазвичай дає яскравіше зображення при слабкому освітленні."
          }
        },
        "vi" : {
          "stringUnit" : {
