    "Beware, changing settings will move the Gimbal to the new position." : {
      "comment" : "A warning message that appears when the user is about to change a Gimbal preset.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beachte, dass durch das Ändern der Einstellungen wird das Gimbal in die neue Position bewegt."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "B3w4r3, ch4ng1ng s3tt1ngs w1ll m0v3 th3 G1mb4l t0 th3 n3w p0s1t10n."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuidado: cambiar los ajustes moverá el Gimbal a la nueva posición."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huomaa, että asetusten muuttaminen siirtää gimbalin uuteen asentoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Attention : modifier les réglages déplacera le Gimbal vers la nouvelle position."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सावधान, सेटिंग्स बदलने पर गिम्बल नई स्थिति में चला जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
