        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moblin mengirim kredensial ini dengan aman ke GoPro yang terhubung melalui Bluetooth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
