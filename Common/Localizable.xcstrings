          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El reloj actúa como asistente de control remoto cuando está habilitado. Tenga en cuenta que, en este caso, no se admiten chat, omisión de texto a voz actual y algunas otras funciones."
          }
        },
        "fi" : {
          "stringUnit" : {
