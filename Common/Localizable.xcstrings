    "Replace `hevc_videotoolbox` with your preferred encoder, typically a hardware encoder for faster conversion." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetze „hevc_videotoolbox“ durch deinen bevorzugten Encoder, normalerweise einen Hardware-Encoder für eine schnellere Konvertierung."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "R3pl@c3 `h3vc_v1d30t00lb0x` w1th y0_r pr3f3rr3d 3nc0d3r, typ1c@lly @ h@rdw@r3 3nc0d3r f0r f@st3r c0nv3rs10n."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reemplace `hevc_videotoolbox` con su codificador preferido, generalmente un codificador de hardware para una conversión más rápida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korvaa \"hevc_videotoolbox\" haluamallasi enkooderilla (yleensä laitteistoenkooderi) nopeampaa muuntamista varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remplacez `hevc_videotoolbox` par votre encodeur préféré, généralement un encodeur matériel pour une conversion plus rapide."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "`hevc_videotoolbox` को अपने पसंदीदा एनकोडर से बदलें, आमतौर पर तेज़ रूपांतरण के लिए एक हार्डवेयर एनकोडर।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ganti `hevc_videotoolbox` dengan encoder pilihan Anda, biasanya encoder perangkat keras untuk konversi yang lebih cepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisci `hevc_videotoolbox` con il codificatore che preferisci, di solito hardware per convertire più in fretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「hevc_videotoolbox」を好みのエンコーダに置き換えます。通常は、変換を高速化するためのハードウェア エンコーダです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`hevc_videotoolbox`를 원하는 인코더(일반적으로 더 빠른 변환을 위한 하드웨어 인코더)로 바꾸세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vervang `hevc_videotoolbox` door de encoder van uw voorkeur, meestal een hardware-encoder voor snellere conversie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zamień `hevc_videotoolbox` na preferowany koder, zazwyczaj koder sprzętowy, aby przyspieszyć konwersję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Substitua `hevc_videotoolbox` pelo seu codificador preferido, normalmente um codificador de hardware para conversão mais rápida."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Substitua `hevc_videotoolbox` pelo seu codificador preferido, normalmente um codificador de hardware para conversão mais rápida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замените `hevc_videotoolbox` на предпочитаемый вами кодировщик, обычно это аппаратный кодировщик для более быстрого преобразования."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
