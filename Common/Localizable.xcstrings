    "‼️ Low on disk. Stopping recording. ‼️" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Wenig Speicherplatz. Stoppt die Aufnahme. ‼️"
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‼️ L0w 0n d1sk. St0pp1ng r3c0rd1ng. ‼️"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‼️ Bajo en disco. Detener la grabación. ‼️"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Matala levytila. Tallennus lopetetaan. ‼️ ️"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Faible espace disque. Arrêt de l'enregistrement. ‼️"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‼️ ️डिस्क पर कम। रिकॉर्डिंग को रोकना। ‼️ ️"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‼️ rendah pada disk. Berhenti merekam. ‼️"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Disco quasi pieno. Registrazione interrotta. ‼️"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‼️ Diskの低い€€。録音の停止。‼️"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ 저장공간 부족. 녹화 중단. ‼️"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Schijf bijna vol. Opname word gestopt. ‼️"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Brak miejsca na dysku. Zatrzymanie nagrywania. ‼️"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Pouco espaço livre. Parando de gravar. ‼️"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‼️ Baixo em disco. Parar de gravar. ‼️"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Хранилище заполнено, остановка записи. ‼️"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ nízko na disku. Zastavenie nahrávania. ‼️"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️️ Nästan slut på disk. Stoppar inspelning. ‼️️"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Disk dolu. Kayıt durduruluyor. ‼️"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‼️ ️Низький на диску. Припинення запису. ‼️"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‼️ thấp trên đĩa. Ngừng ghi âm. ‼️"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️️ 磁盘空间不足。停止录制。 ‼️️"
