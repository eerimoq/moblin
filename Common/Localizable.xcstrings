    "‼️ Low on disk. Stopping recording. ‼️" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Wenig Speicherplatz. Stoppt die Aufnahme. ‼️"
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ L0w 0n d1sk. St0pp1ng r3c0rd1ng. ‼️"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‼️ Poco espacio en disco. Deteniendo la grabación. ‼️"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Matala levytila. Tallennus lopetetaan. ‼️ ️"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Faible espace disque. Arrêt de l'enregistrement. ‼️"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‼️ डिस्क में जगह कम है। रिकॉर्डिंग रोकी जा रही है। ‼️"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‼️ Ruang disk hampir habis. Merekam dihentikan. ‼️"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Disco quasi pieno. Registrazione interrotta. ‼️"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‼️ ディスク容量が不足しています。録画を停止します。‼️"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ 저장공간 부족. 녹화 중단. ‼️"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Schijf bijna vol. Opname word gestopt. ‼️"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Brak miejsca na dysku. Zatrzymanie nagrywania. ‼️"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Pouco espaço livre. Parando de gravar. ‼️"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‼️ Pouco espaço em disco. A parar a gravação. ‼️"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Хранилище заполнено, остановка записи. ‼️"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ nízko na disku. Zastavenie nahrávania. ‼️"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️️ Nästan slut på disk. Stoppar inspelning. ‼️️"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‼️ Disk dolu. Kayıt durduruluyor. ‼️"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‼️ Мало місця на диску. Запис зупиняється. ‼️"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‼️ Sắp hết dung lượng đĩa. Đang dừng ghi hình. ‼️"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
