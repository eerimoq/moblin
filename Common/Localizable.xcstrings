        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अच्छी इमेज क्वालिटी के लिए आमतौर पर लगभग 5-8 Mbps काफी होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sekitar 5-8 Mbps biasanya cukup untuk kualitas gambar yang layak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di solito 5-8 Mbps bastano per una buona qualità d'immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "通常、5〜8 Mbps程度あれば十分な画質が得られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반적으로 5~8 Mbps 정도면 충분한 화질을 제공합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ongeveer 5-8 Mbps is meestal genoeg voor een redelijke beeldkwaliteit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zazwyczaj do uzyskania przyzwoitej jakości streama, wystarcza transfer danych wynoszący 5–8 Mb/s."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca de 5 a 8 Mbps geralmente são suficientes para uma qualidade de imagem decente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cerca de 5-8 Mbps normalmente chega para uma qualidade de imagem razoável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для хорошего качества изображения обычно достаточно скорости 5–8 Мбит/с."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asi 5-8 Mbps je zvyčajne dostatočne na slušnú kvalitu obrazu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cirka 5-8 Mbps brukar räcka för hyfsad bildkvalitet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genellikle 5-8 Mbps civarı bir hız, iyi bir görüntü kalitesi için yeterlidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зазвичай близько 5-8 Мбіт/с достатньо для пристойної якості зображення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Khoảng 5-8 Mbps thường đủ cho chất lượng hình ảnh khá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常大约 5-8 Mbps 就足以获得不错的图像质量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "通常約 5-8 Mbps 就足以獲得不錯的畫質。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大約 5-8 Mbps 通常足以獲得良好的影像品質。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大約 5-8 Mbps 就足夠畫質。"
          }
        }
