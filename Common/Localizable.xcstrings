          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "मोनो ऑडियो केवल आउटपुट चैनल 1 का उपयोग करता है। स्टीरियो ऑडियो दोनों आउटपुट चैनलों का उपयोग करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
