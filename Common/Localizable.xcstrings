    "Give the webpage access to various data in Moblin, for example chat messages and your location." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib der Webseite Zugriff auf verschiedene Daten in Moblin, zum Beispiel Chat-Nachrichten und deinen Standort."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "G1v3 th3 w3bp@g3 @cc3ss t0 v@r10_s d@t@ 1n M0bl1n, f0r 3x@mpl3 ch@t m3ss@g3s @nd y0_r l0c@t10n."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Da a la página web acceso a varios datos de Moblin, por ejemplo mensajes del chat y tu ubicación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna verkkosivustolle pääsy erilaisiin tietoihin Moblin:issa, esimerkiksi chat-viestit ja sijaintisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez à la page Web un accès à diverses données dans Moblin, par exemple les messages du chat et votre emplacement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "वेबपेज को Moblin में विभिन्न डेटा तक पहुंच दें, उदाहरण के लिए चैट संदेश और आपका स्थान।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beri halaman web akses ke berbagai data di Moblin, misalnya pesan chat dan lokasi Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai alla pagina web accesso a vari dati di Moblin, ad esempio i messaggi in chat e la tua posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Webページに、チャットメッセージや位置情報など、Moblin内のさまざまなデータへのアクセスを許可します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹페이지가 Moblin의 다양한 데이터에 접근할 수 있도록 허용합니다. 예: 채팅 메시지, 내 위치 등"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geef de webpagina toegang tot verschillende gegevens in Moblin, bijvoorbeeld chatberichten en je locatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daj stronie internetowej dostęp do różnych danych w Moblin, na przykład wiadomości czatu i lokalizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê acesso à página da web a vários dados em Moblin, por exemplo, mensagens de bate -papo e sua localização."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dá à página web acesso a vários dados no Moblin, por exemplo mensagens do chat e a sua localização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить доступ веб-странице к различным данным в Moblin, например к сообщениям в чате и вашему местоположению."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Udeľte webovej stránke prístup k rôznym údajom v Moblin, napríklad k správam v chate a vašej polohe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge webbsidan tillgång till olika data i Moblin, till exempel chattmeddelanden och din plats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web sayfasının Moblin'deki çeşitli verilere, örneğin sohbet mesajlarına ve konumunuza erişmesini sağlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Надайте вебсторінці доступ до різних даних у Moblin, наприклад повідомлень чату та вашого місцезнаходження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cho phép trang web truy cập nhiều dữ liệu trong Moblin, ví dụ tin nhắn chat và vị trí của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
