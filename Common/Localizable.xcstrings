    "Widgets in selected scene will be shown on the Moblin device the remote control assistant is connected to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets in der ausgewählten Szene werden auf dem Moblin Gerät angezeigt, mit dem der Fernbedienungsassistent verbunden ist."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W1dg3ts 1n s3l3ct3d sc3n3 w1ll b3 sh0wn 0n th3 M0bl1n d3v1c3 th3 r3m0t3 c0ntr0l @ss1st@nt 1s c0nn3ct3d t0."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los widgets de la escena seleccionada se mostrarán en el dispositivo Moblin al que está conectado el asistente de control remoto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valittujen näkymien widgetit näytetään Moblin -laitteessa, johon etähallinnan avustaja on yhdistetty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les widgets de la scène sélectionnés seront affichés sur le l’appareil Moblin auquel l'assistant de contrôle à distance est connecté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "चुने गए सीन के विजेट उस Moblin डिवाइस पर दिखाए जाएँगे जिससे रिमोट कंट्रोल असिस्टेंट जुड़ा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Widget di scene yang dipilih akan ditampilkan di perangkat Moblin tempat asisten kontrol jarak jauh terhubung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I widget nella scena selezionata verranno mostrati sul dispositivo Moblin a cui è collegato l'assistente di controllo remoto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "選択したシーンのウィジェットは、リモートコントロールアシスタントが接続しているMoblinデバイスに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 장면의 위젯이 원격 제어 어시스턴트가 연결된 Moblin 기기에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Widgets in de geselecteerde scène worden getoond op het Moblin-apparaat waarmee de remote control-assistent is verbonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widżety w wybranej scenie zostaną pokazane na urządzeniu Moblin, do którego podłączony jest asystent zdalnego sterowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os widgets na cena selecionada serão mostrados no dispositivo Moblin ao qual o Assistente de Controle Remoto está conectado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os widgets da cena selecionada serão apresentados no dispositivo Moblin ao qual o assistente de controlo remoto está ligado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виджеты в выбранной сцене будут показаны на устройстве Moblin, к которому подключен помощник дистанционного управления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Widgety vo vybranej scéne sa zobrazia na zariadení Moblin, ku ktorému je pripojený asistent diaľkového ovládania."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets i vald scen kommer att visas på Moblin-enheten fjärrkontrollen är ansluten till."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen sahnedeki widget'lar, uzaktan kontrol asistanının bağlı olduğu Moblin cihazında gösterilecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Віджети вибраної сцени відображатимуться на пристрої Moblin, до якого підключено помічник віддаленого керування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Các widget trong cảnh đã chọn sẽ hiển thị trên thiết bị Moblin mà trợ lý điều khiển từ xa đang kết nối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选定场景中的小部件将显示在已连接到遥控助手的Moblin设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "所選場景中的小工具將顯示在遠端控制助理所連接的 Moblin 裝置上。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選定場景中的小工具將顯示在遠端控制助理所連線的 Moblin 裝置上。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已選擇的場景的小工具會顯示在連接中的Moblin遠端控制助手"
          }
        }
