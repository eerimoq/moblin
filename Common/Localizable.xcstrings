    "Synchronize multiple streams on your server using timecodes. Timecodes are in UTC and requires H.265/HEVC codec and SRT(LA) or RIST." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiere mehrere Streams auf deinem Server mithilfe von Timecodes. Timecodes befinden sind in UTC und benötigen H.265/HEVC Codec und SRT(LA) oder RIST."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchr0n1z3 m_lt1pl3 str34ms 0n y0_r s3rv3r _s1ng t1m3c0d3s. T1m3c0d3s 4r3 1n _TC 4nd r3q_1r3s H.265/H3VC c0d3c 4nd SRT(L4) 0r R1ST."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
