    "<filter> is movie, grayscale, sepia, triple, pixellate or 4:3." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<filter> ist Film, Graustufen, Sepia, Dreifach, Pixelliert oder 4:3."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "<f1lt3r> 1s m0v13, gr4ysc4l3, s3p14, tr1pl3, p1x3ll4t3 0r 4:3."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "<filter> es película, escala de grises, sepia, triple, pixelado o 4:3."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<filter> on elokuva, harmaasävy, seepia, kolminkertainen, pikselöity tai 4:3."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<filter> est film, niveaux de gris, sépia, triple, pixellisé ou 4:3."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "<filter> मूवी, ग्रेस्केल, सेपिया, ट्रिपल, पिक्सेलेट या 4:3 है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "<filter> adalah film, skala abu-abu, sepia, rangkap tiga, berpiksel, atau 4:3."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<filtro> è movie, grayscale, sepia, triple, pixellate o 4:3."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "<filter> は、ムービー、グレースケール、セピア、トリプル、ピクセル化、または 4:3 です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<필터> 종류: movie(레터박스), grayscale(흑백), sepia(세피아), triple(3분할), pixellate(모자이크), 4:3."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "<filter> is film, grijswaarden, sepia, triple, pixellate of 4:3."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<filttr> to filtr filmowy, skala szarości, sepia, potrójny, pikselowy lub 4:3."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<filter> é filme, escala de cinza, sépia, triplo, pixellate ou 4:3."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "<filter> é filme, escala de cinza, sépia, triplo, pixellate ou 4:3."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<фильтр> это movie, grayscale, sepia, triple, pixellate или 4:3."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<Filter> je film, grayscale, sépiu, trojitý, pixellate alebo 4:3."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<filter> är film, gråskala, sepia, trippel, pixel eller 4:3."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<filter> film, gri tonlamalı, sepya, üçlü, pikselli veya 4:3'tür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "<filter> — це фільм, відтінки сірого, сепія, потрійний, піксельний або 4:3."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "<filter> là phim, thang độ xám, nâu đỏ, ba, pixellate hoặc 4:3."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<filter> 为电影、灰度、棕褐色、三倍、像素化或 4:3。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "<filter> 是電影、灰階、棕褐色、三重、像素或 4:3。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<filter> 是 電影、灰階、棕褐色、三重、像素化 或 4:3。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<filter> 是 movie, grayscale, sepia, triple, pixellate 或 4:3。"
          }
        }
      }
    },
    "<on/off> is on or off." : {
      "localizations" : {
        "de" : {
