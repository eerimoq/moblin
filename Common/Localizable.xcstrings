    "Enter one of the URLs into the RIST publisher device to send video to this stream. Usually enter the WiFi or Personal Hotspot URL." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib eine der URLs in das RIST Publisher Gerät ein, um Videos an diesen Stream zu senden. Normalerweise gibst du die WLAN- oder persönliche Hotspot-URL ein."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3nt3r 0n3 0f th3 _RLs 1nt0 th3 R1ST p_bl1sh3r d3v1c3 t0 s3nd v1d30 t0 th1s str34m. _s_4lly 3nt3r th3 W1F1 0r P3rs0n4l H0tsp0t _RL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Introduce una de las URL en el dispositivo publicador RIST para enviar vídeo a este stream. Normalmente introduce la URL de WiFi o de Punto de acceso personal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita yksi URL -osoitteista RIST -lähetyslaitteeseen julkaistaksesi videota tähän lähetykseen. Syötä yleensä WiFi- tai Oman hotspotin -URL-osoite."
          }
