    "To show the widget in sync with high latency cameras." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um das Widget synchron mit Kameras mit hoher Latenz anzuzeigen."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T0 sh0w th3 w1dg3t 1n sync w1th h1gh l@t3ncy c@m3r@s."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para mostrar el widget sincronizado con cámaras de alta latencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgetin näyttäminen synkronoituna korkean viiveen kameroiden kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pour afficher le widget en synchronisation avec les caméras à latence élevée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "विजेट को अधिक लेटेंसी वाले कैमरों के साथ सिंक में दिखाने के लिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Untuk menampilkan widget secara sinkron dengan kamera berlatensi tinggi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per mostrare il widget in sincronia con fotocamere ad alta latenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "高遅延カメラに同期してウィジェットを表示するため。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지연 시간이 긴 카메라와 동기화된 위젯을 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Om de widget synchroon te tonen met camera's met hoge latentie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby wyświetlić widget zsynchronizowany z kamerami o dużym opóźnieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mostrar o widget sincronizado com câmeras de alta latência."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para mostrar o widget sincronizado com câmaras de alta latência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для отображения виджета синхронно с камерами с большой задержкой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
