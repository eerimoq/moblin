    "Automatically lower resolution when the available bandwidth is low. Generally gives better image quality at low (< 750 Kbps) bitrates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatische Reduzierung der Auflösung bei geringer verfügbarer Bandbreite. Im Allgemeinen ergibt sich bei niedrigen Bitraten (< 750 Kbps) eine bessere Bildqualität."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "4_t0m4t1c4lly l0w3r r3s0l_t10n wh3n th3 4v41l4bl3 b4ndw1dth 1s l0w. G3n3r4lly g1v3s b3tt3r 1m4g3 q_4l1ty 4t l0w (< 750 Kbps) b1tr4t3s."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce automáticamente la resolución cuando el ancho de banda disponible es bajo. Generalmente ofrece una mejor calidad de imagen a velocidades de bits bajas (< 750 Kbps)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laskee resoluutiota automaattisesti, kun käytettävissä oleva kaistanleveys on pieni. Yleisesti antaa paremman kuvanlaadun alhaisilla (< 750 Kbps) bittinopeuksilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Réduit automatiquement la résolution lorsque la bande passante disponible est faible. Donne généralement une meilleure qualité d'image à des débits binaires faibles (< 750 Kbps)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपलब्ध बैंडविड्थ कम होने पर स्वचालित रूप से रिज़ॉल्यूशन कम करें। आम तौर पर कम (< 750 Kbps) बिटरेट पर बेहतर छवि गुणवत्ता देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secara otomatis menurunkan resolusi saat bandwidth yang tersedia rendah. Umumnya memberikan kualitas gambar yang lebih baik pada bitrate rendah (< 750 Kbps)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbassa la risoluzione quando la banda è poca. Di solito dà una qualità migliore a bitrate bassi (< 750 Kbps)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用可能な帯域幅が低い場合は、解像度を自動的に下げます。通常、低い (< 750 Kbps) ビットレートでは、画像の品質が向上します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 가능한 대역폭이 낮을 때 자동으로 해상도를 낮춥니다. 일반적으로 낮은 (< 750 Kbps) 비트레이트에서 더 나은 화질을 제공합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch lagere resolutie wanneer de beschikbare bandbreedte laag is. Geeft over het algemeen betere beeldkwaliteit bij lage (< 750 Kbps) bitrates."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatycznie obniż rozdzielczość, gdy przepustowość jest niska. Generalnie daje lepszą jakość obrazu przy niskich (< 750 Kbps) przepustowościach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduz automaticamente a resolução quando a largura de banda disponível é baixa. Geralmente oferece melhor qualidade de imagem em taxas de bits baixas (< 750 Kbps)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduz automaticamente a resolução quando a largura de banda disponível é baixa. Geralmente oferece melhor qualidade de imagem em taxas de bits baixas (< 750 Kbps)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически понижает разрешение стрима когда доступная ширина канала становится меньше. При включении даёт более высокое качество изображения при низком битрейте (< 750 Кбит/с)"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky nižšie rozlíšenie, keď je dostupná šírka pásma nízka. Všeobecne poskytuje lepšiu kvalitu obrazu pri nízkych (< 750 kbps) bitrátoch."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sänk upplösningen automatiskt när den tillgängliga bandbredden är låg. Ger generellt bättre bildkvalitet vid låga (< 750 Kbps) bithastigheter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut bant genişliği düşük olduğunda çözünürlüğü otomatik olarak düşürür. Genellikle düşük (< 750 Kbps) bit hızlarında daha iyi görüntü kalitesi verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматичне зниження роздільної здатності, коли доступна пропускна здатність низька. Зазвичай забезпечує кращу якість зображення за низьких (< 750 Кбіт/с) бітрейтів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động giảm độ phân giải khi băng thông khả dụng thấp. Nói chung mang lại chất lượng hình ảnh tốt hơn ở tốc độ bit thấp (< 750 Kbps)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用带宽较低时自动降低分辨率。通常在低比特率（< 750 Kbps）下能提供更好的图像质量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當可用頻寬較低時自動降低解析度。通常以低位元速率 (< 750 Kbps) 提供更好的影像品質。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當網路頻寬較低時自動降低解析度。通常以低位元率 (< 750 Kbps) 提供較佳的影像品質。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網速不足時自動降低解析度。在低碼率情況下(< 750 Kbps)提供更好的畫質。"
          }
        }
      }
    },
