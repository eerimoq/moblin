          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod QR i przycisk kopiowania do schowka pojawią się tutaj, gdy powyższe ustawienia zostaną zmodyfikowane (i nie są wartościami domyślnymi)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um código QR e um botão copiar para a área de transferência aparecerão aqui quando as configurações acima forem modificadas (e nem todas são valores padrão)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
