    "Do not say messages that are likely spam or bot commands." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auslassen von Spam oder Bot-Befehle handelt."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D0 n0t s@y m3ss@g3s th@t @r3 l1k3ly sp@m 0r b0t c0mm@nds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No decir mensajes que probablemente sean spam o comandos de bot."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älä puhu viestejä, jotka ovat todennäköisesti roskapostia tai bottikomentoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne prononcez pas de messages susceptibles d'être du spam ou des commandes de bot."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ऐसे संदेश न बोलें जो संभवतः स्पैम या बॉट कमांड हों।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jangan ucapkan pesan yang kemungkinan spam atau perintah bot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non leggere i messaggi che sembrano spam o comandi bot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スパムまたはボットコマンドの可能性があるメッセージを読み上げない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스팸이나 봇 명령어로 의심되는 메시지는 읽지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spreek geen berichten uit die waarschijnlijk spam of bot opdrachten zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie wypowiadaj wiadomości, które prawdopodobnie są spamem lub poleceniami botów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não diga mensagens que provavelmente sejam spam ou comandos de bot."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Não dizer mensagens que provavelmente sejam spam ou comandos de bot."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не зачитывать сообщения, которые могут быть спамом или командами ботов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenapíše správy, ktoré sú pravdepodobné príkazy spamu alebo BOT."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
