    "Find your channel name (myChannelName) and video id (myVideoId) in your stream's URL." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche deinen Kanalnamen (myChannelName) und deine Video-ID (myVideoId) in der URL deines Streams."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "F1nd y0_r ch4nn3l n4m3 (myCh4nn3lN4m3) 4nd v1d30 1d (myV1d301d) 1n y0_r str34m's _RL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca el nombre de tu canal (myChannelName) y el ID de tu vídeo (myVideoId) en la URL de tu transmisión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etsi kanavasi nimi (myChannelName) ja videotunnus (myVideoId) lähetyksesi URL-osoitteesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrouvez votre nom de chaîne (nomDeMaChaine) et votre identifiant vidéo (monIdVideo) dans l'URL de votre stream."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अपनी स्ट्रीम के URL में अपना चैनल नाम (MyChannelName) और वीडियो आईडी (MyVideoid) खोजें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Temukan nama saluran Anda (mychannelname) dan ID video (myvideoid) di URL stream Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
