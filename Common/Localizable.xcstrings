    "A low-quality low-latency stream sent to a WHIP server. Can be used to preview the stream from another device." : {
      "comment" : "A description of the preview stream.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Stream mit geringer Qualität und geringer Latenz, der an einen WHIP-Server gesendet wird. Kann zur Vorschau des Streams von einem anderen Gerät verwendet werden."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "@ l0w-q_@l1ty l0w-l@t3ncy str3@m s3nt t0 @ WH1P s3rv3r. C@n b3 _s3d t0 pr3v13w th3 str3@m fr0m @n0th3r d3v1c3."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un stream de baja calidad y baja latencia enviado a un servidor WHIP. Se puede usar para previsualizar el stream desde otro dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WHIP-palvelimelle lähetetty matalalaatuinen lyhyen viiveen lähetys. Voidaan käyttää lähetyksen esikatseluun toisesta laitteesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un stream basse qualité et basse latence envoyé à un serveur WHIP. Peut servir à prévisualiser le stream depuis un autre appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "WHIP सर्वर को भेजी गई कम गुणवत्ता और कम लेटेंसी वाली स्ट्रीम। इसका उपयोग किसी अन्य डिवाइस से स्ट्रीम का प्रीव्यू देखने के लिए किया जा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stream berkualitas rendah dengan latensi rendah yang dikirim ke server WHIP. Dapat digunakan untuk pratinjau stream dari perangkat lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno stream a bassa qualità e bassa latenza inviato a un server WHIP. Serve per vedere l'anteprima da un altro dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "WHIPサーバーに送信される低画質・低遅延のストリーム。別のデバイスからストリームをプレビューするのに使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "WHIP 서버로 전송되는 저화질 저지연 스트림입니다. 다른 기기에서 스트림을 미리 보는 데 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Een stream van lage kwaliteit en lage latentie die naar een WHIP-server wordt gestuurd. Kan worden gebruikt om de stream op een ander apparaat te bekijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Strumień niskiej jakości i niskich opóźnień wysyłany do serwera WHIP. Można go użyć do podglądu strumienia na innym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um stream de baixa qualidade e baixa latência enviado a um servidor WHIP. Pode ser usado para visualizar o stream em outro dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
