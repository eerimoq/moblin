    "Swipe left on %@ to delete it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische auf %@ nach links, um es zu löschen."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sw1p3 l3ft 0n %@ t0 d3l3t3 1t."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia la izquierda en %@ para eliminarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista %@ pyyhkäisemällä vasemmalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser %@ vers la gauche pour supprimer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ को हटाने के लिए उस पर बाईं ओर स्वाइप करें।"
          }
        },
        "id" : {
