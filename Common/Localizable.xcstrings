    "H.265/HEVC generally requires less bandwidth for same image quality. RTMP generally only supports H.264/AVC." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC erfordert im Allgemeinen weniger Bandbreite für die gleiche Bildqualität. RTMP unterstützt im Allgemeinen nur H.264/AVC."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/H3VC g3n3r4lly r3q_1r3s l3ss b4ndw1dth f0r s4m3 1m4g3 q_4l1ty. RTMP g3n3r4lly 0nly s_pp0rts H.264/4VC."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC suele requerir menos ancho de banda con la misma calidad de imagen. RTMP normalmente solo admite H.264/AVC."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC vaatii yleensä vähemmän kaistanleveyttä samaan kuvanlaatuun. RTMP tukee yleensä vain H.264/AVC:tä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC nécessite généralement moins de bande passante pour la même qualité d'image. RTMP ne prend généralement en charge que H.264/AVC."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "समान इमेज क्वालिटी के लिए H.265/HEVC को आमतौर पर कम बैंडविड्थ चाहिए। RTMP आमतौर पर केवल H.264/AVC को सपोर्ट करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC umumnya membutuhkan bandwidth lebih kecil untuk kualitas gambar yang sama. RTMP umumnya hanya mendukung H.264/AVC."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC richiede meno banda a parità di qualità. RTMP di solito supporta solo H.264/AVC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVCは同じ画質ならたいてい必要な帯域幅が少なくなります。RTMPは通常H.264/AVCのみ対応しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC는 일반적으로 동일한 화질대비 필요한 대역폭이 적습니다. RTMP는 일반적으로 H.264/AVC만 지원합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC heeft doorgaans minder bandbreedte nodig voor dezelfde beeldkwaliteit. RTMP ondersteunt meestal alleen H.264/AVC."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC zazwyczaj wymaga mniejszej przepustowości dla tej samej jakości obrazu. RTMP ogólnie obsługuje tylko H.264/AVC."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC geralmente requer menos largura de banda para a mesma qualidade de imagem. O RTMP geralmente suporta apenas H.264/AVC."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC geralmente requer menos largura de banda para a mesma qualidade de imagem. RTMP geralmente só suporta H.264/AVC."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC требует меньшей пропускной способности для того же качества изображения. RTMP обычно поддерживает только H.264/AVC."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC vo všeobecnosti vyžaduje menšiu šírku pásma pri rovnakej kvalite obrazu. RTMP zvyčajne podporuje iba H.264/AVC."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC kräver i allmänhet mindre bandbredd för samma bildkvalitet. RTMP stöder i allmänhet endast H.264/AVC."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC genellikle aynı görüntü kalitesi için daha az bant genişliği gerektirir. RTMP genellikle sadece H.264/AVC'yi destekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC зазвичай потребує меншої пропускної здатності за тієї ж якості зображення. RTMP зазвичай підтримує лише H.264/AVC."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC thường cần ít băng thông hơn với cùng chất lượng hình ảnh. RTMP thường chỉ hỗ trợ H.264/AVC."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC通常只需要更少的带宽就能获得与H.264/AVC相同的图像质量。 RTMP通常仅支持H.264/AVC。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "H.265/HEVC 在相同畫質下通常所需頻寬較少。RTMP 通常僅支援 H.264/AVC。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC通常在相同影像品質下所需的頻寬更低。RTMP通常只支援H.264/AVC。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.265/HEVC用更少流量就能有相對好的畫質，RTMP通常只支援H.264/AVC"
          }
        }
      }
    },
