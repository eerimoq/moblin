          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'audio mono usa solo il canale di uscita 1. Lo stereo usa entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モノラルオーディオは出力チャンネル 1 のみを使用します。ステレオオーディオは両方の出力チャンネルを使用します。"
