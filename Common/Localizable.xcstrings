    "Mono audio only uses output channel 1. Stereo audio uses both output channels." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mono-Audio verwendet nur Ausgangskanal 1. Stereo-Audio verwendet beide Ausgangskanäle."
          }
        },
        "eo" : {
          "stringUnit" : {
