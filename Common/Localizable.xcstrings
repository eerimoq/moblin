    "About 5-8 Mbps is usually enough for decent image quality." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für eine ordentliche Bildqualität reichen in der Regel etwa 5–8 Mbps aus."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "4b0_t 5-8 Mbps 1s _s_4lly 3n0_gh f0r d3c3nt 1m4g3 q_4l1ty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Generalmente entre 5 y 8 Mbps es suficiente para una calidad de imagen decente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noin 5-8 Mbps riittää yleensä riittävään kuvanlaatuun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ 5 à 8 Mbps sont généralement suffisants pour une bonne qualité d'image."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अच्छी छवि गुणवत्ता के लिए आमतौर पर 5-8 एमबीपीएस पर्याप्त होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sekitar 5-8 Mbps biasanya cukup untuk kualitas gambar yang layak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di solito 5-8 Mbps bastano per una buona qualità d'immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "通常、適切な画質を得るには約 5 ～ 8 Mbps で十分です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반적으로 5~8 Mbps 정도면 충분한 화질을 제공합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Meestal is 5-8 Mbps voldoende voor een redelijke beeldkwaliteit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zazwyczaj do uzyskania przyzwoitej jakości streama, wystarcza transfer danych wynoszący 5–8 Mb/s."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca de 5 a 8 Mbps geralmente são suficientes para uma qualidade de imagem decente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cerca de 5 a 8 Mbps geralmente são suficientes para uma qualidade de imagem decente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для хорошего качества изображения обычно достаточно скорости 5–8 Мбит/с."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asi 5-8 Mbps je zvyčajne dostatočne na slušnú kvalitu obrazu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
