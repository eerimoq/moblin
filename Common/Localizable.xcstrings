          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Đặt GoPro vào chế độ ghép nối, để gần và đảm bảo GoPro Quik đã ngắt kết nối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
