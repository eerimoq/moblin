    " %@, you are not allowed to take snapshots, sorry. 😢" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, du darfst keine Schnappschüsse machen, sorry. 😢"
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " %@, y0_ 4r3 n0t 4ll0w3d t0 t4k3 sn4psh0ts, s0rry. 😢"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@, no se le permite tomar instantáneas, lo siento. 😢"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, sinulla ei ole oikeutta ottaa kuvankaappauksia, anteeksi. 😢"
