          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System, похоже, лучше всего работает для TMobile. IPv4, вероятно, лучше всего подходит для IRLToolkit."
          }
        },
        "sk" : {
          "stringUnit" : {
