    "⚠️ Disable Settings → Scenes → Scene switching → Force transition to enable groups." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Deaktiviere Einstellungen → Szenen → Szenenwechsel → Übergang erzwingen, um Gruppen zu aktivieren."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ D1s@bl3 S3tt1ngs → Sc3n3s → Sc3n3 sw1tch1ng → F0rc3 tr@ns1t10n t0 3n@bl3 gr0_ps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ Deshabilite Configuración → Escenas → Cambio de escena → Forzar transición para habilitar grupos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Poista käytöstä Asetukset → Näkymät → Näkymän vaihto → Pakota siirtymä ottamiseksi ryhmät käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ Désactivez Paramètres → Scènes → Changement de scène → Forcer la transition pour activer les groupes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ सेटिंग्स अक्षम करें → दृश्य → दृश्य स्विचिंग → समूहों को सक्षम करने के लिए बलपूर्वक संक्रमण।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⚠️ Nonaktifkan Pengaturan → Pemandangan → Peralihan pemandangan → Paksa transisi untuk mengaktifkan grup."
          }
