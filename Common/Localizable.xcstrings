    "Receive chat and events from the assistant instead of directly from the streaming platform." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfange Chats und Ereignisse vom Assistenten statt direkt von der Streaming-Plattform."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "R3c31v3 ch4t 4nd 3v3nts fr0m th3 4ss1st4nt 1nst34d 0f d1r3ctly fr0m th3 str34m1ng pl4tf0rm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Recibe chat y eventos del asistente en lugar de directamente desde la plataforma de streaming."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastaanota chatit ja tapahtumat suoraan avustajalta  kohdealustalta sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Recevez des discussions et des événements depuis l'assistant plutôt que directement depuis la plateforme de streaming."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सीधे स्ट्रीमिंग प्लेटफ़ॉर्म के बजाय सहायक से चैट और ईवेंट प्राप्त करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Terima obrolan dan acara dari asisten, bukan langsung dari platform streaming."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi chat ed eventi dall'assistente invece che direttamente dalla piattaforma di streaming."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ストリーミング プラットフォームから直接ではなく、アシスタントからチャットやイベントを受信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스트리밍 플랫폼에서 직접 받는 대신 어시스턴트로부터 채팅과 이벤트를 받으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ontvang chat en evenementen van de assistent in plaats van rechtstreeks vanaf het streamingplatform."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otrzymuj czaty i wydarzenia od asystenta zamiast bezpośrednio z platformy streamingowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Receba bate-papo e eventos do assistente em vez de diretamente da plataforma de streaming."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
