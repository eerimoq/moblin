    "Can be used when using Moblin as a server at home with stable internet connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kann verwendet werden, wenn Moblin als Server zu Hause mit einer stabilen Internetverbindung eingesetzt wird."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C@n b3 _s3d wh3n _s1ng M0bl1n @s @ s3rv3r @t h0m3 w1th st@bl3 1nt3rn3t c0nn3ct10n."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se puede usar al utilizar Moblin como servidor en casa con una conexión a internet estable."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voidaan käyttää, kun käytät Moblinia palvelimena kotona vakaan Internet -yhteydellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisable quand Moblin sert de serveur à la maison avec une connexion internet stable."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "घर पर स्थिर इंटरनेट कनेक्शन के साथ Moblin को सर्वर के रूप में उपयोग करते समय इस्तेमाल किया जा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dapat digunakan saat memakai Moblin sebagai server di rumah dengan koneksi internet stabil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utile se usi Moblin come server a casa con connessione Internet stabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "安定したインターネット接続のある自宅でMoblinをサーバーとして使う場合に利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집에서 인터넷과 안정적으로 연결되어 있고 Moblin을 서버로 사용할 때 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Te gebruiken als je Moblin thuis als server gebruikt met een stabiele internetverbinding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może być używany podczas pracy Moblin jako serwera w domu ze stabilnym połączeniem internetowym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pode ser usado ao usar o Moblin como servidor em casa com conexão de internet estável."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
