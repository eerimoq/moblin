        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "啟用後，即使應用程式處於背景模式，即使沒有進行串流傳輸，也可以保持聊天活動。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
