        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@，不允許您拍​​攝快照，對不起。 😢"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
