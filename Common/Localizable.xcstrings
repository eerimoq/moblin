        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gunakan simpan/muat tata letak untuk menempatkan widget di posisi yang sama di beberapa scene. Atau, gunakan widget Scene untuk menampilkan widget yang sama di beberapa scene dengan mudah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
