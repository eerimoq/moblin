    "Feel free to join Moblin Discord server or write an issue on Github if you need help or want to give feedback." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst dem Moblin Discord Server beitreten oder eine Nachricht auf Github schreiben, wenn du Hilfe benötigst oder Feedback geben möchtest."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "F33l fr33 t0 j01n M0bl1n D1sc0rd s3rv3r 0r wr1t3 4n 1ss_3 0n G1th_b 1f y0_ n33d h3lp 0r w4nt t0 g1v3 f33db4ck."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No dudes en unirte al servidor de Discord de Moblin o escribir una incidencia en Github si necesitas ayuda o quieres dar tu opinión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liity Moblin:in Discord-palvelimelle tai kirjoita ongelmasta Githubiin, jos tarvitset apua tai haluat antaa palautetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'hésitez pas à rejoindre le serveur Discord Moblin ou à déclarer un problème sur Github si vous avez besoin d'aide ou souhaitez soumettre un retour d'expérience."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moblin Discord Server में शामिल होने के लिए स्वतंत्र महसूस करें या GitHub पर एक समस्या लिखें यदि आपको सहायता की आवश्यकता है या प्रतिक्रिया देना चाहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jangan ragu untuk bergabung dengan Moblin Discord Server atau menulis masalah di GitHub jika Anda membutuhkan bantuan atau ingin memberikan umpan balik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entra nel server Discord di Moblin o apri una issue su GitHub se ti serve aiuto o vuoi lasciare un feedback."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルプが必要な場合やフィードバックを提供したい場合は、Moblin Discord ServerかGithubへ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도움이 필요하거나 피드백을 주고 싶다면 언제든지 Moblin 디스코드 서버에 가입하거나 Github에 issue를 작성해주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voel je vrij om lid te worden van de Moblin Discord Server of meld een probleem op GitHub als je hulp nodig hebt of feedback wilt geven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrzebujesz pomocy lub chcesz wyrazić swoją opinię? Dołącz do serwera Moblin na Discordzie, bądź napisz zgłoszenie na Githubie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinta-se à vontade para ingressar no servidor Moblin Discord ou escrever um problema no Github se precisar de ajuda ou quiser dar feedback."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sinta-se à vontade para ingressar no servidor Moblin Discord ou escrever um problema no Github se precisar de ajuda ou quiser dar feedback."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не стесняйтесь сообщить о проблеме на сервере Moblin в Discord или написать о проблеме на Github если вам нужна помощь или вы хотите оставить отзыв."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ak potrebujete pomoc alebo chcete poskytnúť spätnú väzbu, neváhajte a pripojte sa k serveru Moblin Discord alebo napíšte problém."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joina gärna Moblins Discord server eller skriv ett ärende på Github om du behöver hjälp eller vill ge feedback."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yardıma ihtiyacınız varsa veya geri bildirim vermek istiyorsanız Moblin Discord sunucusuna katılmaktan veya GitHub'da bir sorun bildirimi oluşturmaktan çekinmeyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не соромтеся приєднатися до сервера Moblin Discord або написати питання на Github, якщо вам потрібна допомога або ви хочете залишити відгук."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vui lòng tham gia Moblin Discord Server hoặc viết một vấn đề trên GitHub nếu bạn cần trợ giúp hoặc muốn đưa ra phản hồi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你需要帮助或者想提供反馈，欢迎加入 Moblin Discord 服务器讨论或者在 GitHub 上写下你的问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
