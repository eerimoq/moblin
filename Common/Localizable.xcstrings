    "Enter one of the URL:s as \"Streamer URL\" in the relay device to use it as an additional bonding connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage eine der URLs als „Streamer-URL“ in das Relay-Gerät ein, um diese als zusätzliche Bonding-Verbindung zu nutzen."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
