    "Wait until a viewer redeems the reward, then continue with the following actions. Leave reward empty to wait for any reward." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet bis ein Zuschauer die Belohnung einlöst und fährt dann mit den darauf folgenden Aktionen fort. Lass das Feld „Belohnung“ leer, um auf eine beliebige Belohnung zu warten."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W41t _nt1l 4 v13w3r r3d33ms th3 r3w4rd, th3n c0nt1n_3 w1th th3 f0ll0w1ng 4ct10ns. L34v3 r3w4rd 3mpty t0 w41t f0r 4ny r3w4rd."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Espera hasta que un espectador canjee la recompensa y luego continúa con las siguientes acciones. Deja la recompensa vacía para esperar cualquier recompensa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odottaa, kunnes katsoja lunastaa palkinnon, ja jatkaa sitten seuraaviin toimintoihin. Jätä palkinto tyhjäksi odottaaksesi mitä tahansa palkintoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Attend qu'un spectateur échange la récompense, puis continue avec les actions suivantes. Laissez la récompense vide pour attendre n'importe quelle récompense."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जब तक कोई दर्शक रिवॉर्ड रिडीम नहीं करता तब तक प्रतीक्षा करता है, फिर आगे की क्रियाएँ जारी रखता है। किसी भी रिवॉर्ड की प्रतीक्षा के लिए रिवॉर्ड खाली छोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menunggu hingga penonton menukarkan hadiah, lalu melanjutkan ke aksi berikutnya. Kosongkan hadiah untuk menunggu hadiah apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Attende che uno spettatore riscatti la ricompensa, poi continua con le azioni successive. Lascia vuota la ricompensa per attendere qualsiasi ricompensa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "視聴者が報酬を引き換えるまで待ち、その後、次のアクションに進みます。報酬を空にすると、どの報酬でも待機します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "시청자가 보상을 교환할 때까지 기다린 후 다음 동작을 계속합니다. 보상을 비워 두면 모든 보상을 기다립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wacht tot een kijker de beloning inwisselt en gaat dan verder met de volgende acties. Laat beloning leeg om op elke beloning te wachten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Czeka, aż widz odbierze nagrodę, a następnie kontynuuje kolejne akcje. Pozostaw nagrodę pustą, aby czekać na dowolną nagrodę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Espera até um espectador resgatar a recompensa e depois continua com as ações seguintes. Deixe a recompensa vazia para esperar qualquer recompensa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
