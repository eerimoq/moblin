    "System seems to work best for TMobile. IPv4 probably best for IRLToolkit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das System scheint für T-Mobile am besten zu funktionieren. IPv4 ist wahrscheinlich am besten für IRLToolkit."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Syst3m s33ms t0 w0rk b3st f0r TM0b1l3. 1Pv4 pr0b4bly b3st f0r 1RLT00lk1t."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El sistema parece funcionar mejor con TMobile. IPv4 probablemente sea mejor para IRLToolkit."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestelmä näyttää toimivan parhaiten TMobilen kanssa. IPv4 on luultavasti paras IRLToolkit:ille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le système semble fonctionner le mieux pour TMobile. IPv4 est probablement mieux pour IRLToolkit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सिस्टम TMobile के लिए सबसे अच्छा काम करता है। IPv4 शायद IRLToolkit के लिए सबसे अच्छा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sistem tampaknya bekerja paling baik untuk TMobile. IPv4 mungkin paling baik untuk IRLToolkit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
