    "Press \"Add automatically to Moblin\" on https://cloud.belabox.net SRT(LA) relays (requires login). See screenshot below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf „Automatisch zu Moblin hinzufügen“ auf https://cloud.belabox.net SRT(LA)-Relays (Anmeldung erforderlich). Siehe Screenshot unten."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pr3ss \"4dd 4_t0m4t1c4lly t0 M0bl1n\" 0n https://cl0_d.b3l4b0x.n3t SRT(L4) r3l4ys (r3q_1r3s l0g1n). S33 scr33nsh0t b3l0w."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presione \"Agregar automáticamente a Moblin\" en https://cloud.belabox.net SRT(LA) relays (requiere inicio de sesión). Vea la captura de pantalla a continuación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina \"Add automatically to Moblin\" -nappia https://cloud.belabox.net SRT(LA) -välityspalvelimesta (vaatii kirjautumisen). Katso kuvakaappaus alla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur \"Ajouter automatiquement à Moblin\" sur les relais SRT(LA) https://cloud.belabox.net (connexion requise). Voir capture d'écran ci-dessous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "https://cloud.belabox.net SRT(LA) रिले पर \"मोबलिन में स्वचालित रूप से जोड़ें\" दबाएँ (लॉगिन की आवश्यकता है)। नीचे स्क्रीनशॉट देखें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tekan \"Tambahkan secara otomatis ke Moblin\" pada relai https://cloud.belabox.net SRT(LA) (memerlukan login). Lihat tangkapan layar di bawah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi \"Aggiungi automaticamente a Moblin\" sui relay SRT(LA) di https://cloud.belabox.net (richiede l'accesso). Vedi lo screenshot sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "https://cloud.belabox.net SRT(LA) リレーで [Moblin に自動的に追加] を押します (ログインが必要です)。以下のスクリーンショットを参照してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "https://cloud.belabox.net SRT(LA) relays에서 \"Add automatically to Moblin\"를 누르세요(로그인 필요). 아래 스크린샷을 참고하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Druk op \"Automatisch toevoegen aan Moblin\" op https://cloud.belabox.net SRT(LA)-relais (inloggen vereist). Zie onderstaande schermafbeelding."
          }
        },
        "pl" : {
          "stringUnit" : {
