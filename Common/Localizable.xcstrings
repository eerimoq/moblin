    "Download enhanced and premium voices in iOS Settings → Accessibility → Live Speech → Preferred Voices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade erweiterte und Premium Stimmen unter iOS Einstellungen → Bedienungshilfen → Live -Sprachausgabe → Stimmen herunter."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D0wnl0@d 3nh@nc3d @nd pr3m1_m v01c3s 1n 10S S3tt1ngs → @cc3ss1b1l1ty → L1v3 Sp33ch → Pr3f3rr3d V01c3s."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Descarga voces mejoradas y premium en Ajustes de iOS → Accesibilidad → Voz en directo → Voces preferidas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lataa parannetut ja premium -puheääniä iOS Asetukset → Käyttöapu → Live-puhe → Puheäänet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Téléchargez des voix améliorées et premium dans Réglages iOS → Accessibilité → Voix en direct → Voix préférées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOS सेटिंग्ज़ → अभिगम्यता → Live Speech → पसंदीदा आवाज़ें में एन्हांस्ड और प्रीमियम आवाज़ें डाउनलोड करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Unduh suara enhanced dan premium di Pengaturan iOS → Aksesibilitas → Live Speech → Suara Pilihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica le voci avanzate e premium in Impostazioni iOS → Accessibilità → Voce dal vivo → Voci preferite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOS設定 → アクセシビリティ → ライブスピーチ → 優先する声 で、拡張音声とプレミアム音声をダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 설정 → 손쉬운 사용 → 실시간 말하기 → 선호하는 음성에서 고품질 및 프리미엄 음성을 다운로드하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Download verbeterde en premium stemmen in iOS-instellingen → Toegankelijkheid → Live spraak → Voorkeursstemmen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobierz ulepszone i premium głosy w ustawieniach iOS → Dostępność → Mowa na żywo → Preferowane głosy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baixe vozes aprimoradas e premium em Ajustes do iOS → Acessibilidade → Fala ao Vivo → Vozes Preferidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Transfira vozes melhoradas e premium em Definições do iOS → Acessibilidade → Voz em Direto → Vozes Preferidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузите Enhanced и Premium Voices в настройках iOS → Универсальный доступ → Чтение вслух → Голоса."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vylepšené a prémiové hlasy si stiahnete v Nastaveniach iOS → Zjednodušenie ovládania → Živá reč → Preferované hlasy."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladda ner förbättrade och premiumröster i iOS-inställningar → Tillgänglighet → Live Speech → föredragna röster."
