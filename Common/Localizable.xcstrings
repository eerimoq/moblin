    "Start a screen capture by long-pressing the record button in iOS Control Center and select Moblin." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte eine Bildschirmaufnahme, indem du im iOS Kontrollzentrum lange auf die Aufnahmetaste drückst und Moblin auswählst."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "St@rt @ scr33n c@pt_r3 by l0ng-pr3ss1ng th3 r3c0rd b_tt0n 1n 10S C0ntr0l C3nt3r @nd s3l3ct M0bl1n."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inicie una captura de pantalla manteniendo presionado el botón de grabación en el Centro de control de iOS y seleccione Moblin."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloita ruudunkaappaus painamalla pitkään tallennuspainiketta iOS-ohjauskeskuksessa ja valitsemalla Moblin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Démarrez une capture d'écran en appuyant longuement sur le bouton d'enregistrement dans le centre de contrôle iOS et sélectionnez Moblin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOS नियंत्रण केंद्र में रिकॉर्ड बटन को लंबे समय तक दबाकर स्क्रीन कैप्चर प्रारंभ करें और मोबलिन का चयन करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mulai tangkapan layar dengan menekan lama tombol rekam di Pusat Kontrol iOS dan pilih Moblin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia una cattura schermo tenendo premuto il pulsante di registrazione nel Centro di Controllo iOS e scegli Moblin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iOS コントロール センターの録画ボタンを長押しして画面キャプチャを開始し、Moblin を選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 제어 센터에서 '화면 기록' 버튼을 길게 눌러 Moblin을 선택하고 '기록 시작'을 누르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Start een schermopname door lang op de opnameknop in iOS Control Center te drukken en Moblin te selecteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpocznij nagrywanie ekranu, naciskając długo przycisk nagrywania w Centrum sterowania iOS i wybierając Moblin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inicie uma captura de tela pressionando longamente o botão de gravação no iOS Control Center e selecione Moblin."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inicie uma captura de tela pressionando longamente o botão de gravação no iOS Control Center e selecione Moblin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустите \"Запись экрана\" в Центре управления iOS и выберите Moblin (нужно зажать иконку записи экрана)"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Snímanie obrazovky spustíte dlhým stlačením tlačidla nahrávania v ovládacom centre iOS a výberom položky Moblin."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starta en skärmdump genom att trycka länge på inspelningsknappen i iOS Control Center och välj Moblin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İOS Kontrol Merkezi'ndeki kayıt düğmesine uzun basarak ekran yakalamayı başlatın ve Moblin'i seçin."
          }
