    "Make built-in and USB cameras not freeze in background mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorgt dafür, dass integrierte Kameras und USB-Kameras im Hintergrundmodus nicht einfrieren."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "M@k3 b_1lt-1n @nd _SB c@m3r@s n0t fr33z3 1n b@ckgr0_nd m0d3."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Haga que las cámaras integradas y USB no se congelen en modo de fondo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmistaa, että sisäänrakennetut ja USB-kamerat eivät jumiudu taustatilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Assurez-vous que les caméras intégrées et USB ne se figent pas en mode arrière-plan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बिल्ट-इन और यूएसबी कैमरे को बैकग्राउंड मोड में फ्रीज न होने दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jadikan kamera internal dan USB tidak membeku dalam mode latar belakang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impedisce a fotocamere integrate e USB di bloccarsi in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "内蔵カメラと USB カメラがバックグラウンド モードでフリーズしないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내장 및 USB 카메라가 백그라운드 모드에서 멈추지 않도록 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zorg ervoor dat ingebouwde camera's en USB-camera's niet vastlopen in de achtergrondmodus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spraw, aby kamery wbudowane i USB nie zawieszały się w trybie tła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faça com que as câmeras integradas e USB não congelem no modo de segundo plano."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faça com que as câmeras integradas e USB não congelem no modo de segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите чтобы встроенная и USB-камеры не зависали в фоновом режиме."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zabezpečte, aby vstavané kamery a fotoaparáty USB nezamrzli v režime na pozadí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör att inbyggda kameror och USB-kameror inte fryser i bakgrundsläge."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yerleşik ve USB kameraların arka plan modunda donmamasını sağlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зробіть так, щоб вбудована та USB камери не зависали у фоновому режимі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Làm cho camera tích hợp và USB không bị treo ở chế độ nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "使内置和 USB 摄像头在后台模式下不会冻结。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "使內建和 USB 攝影機在後台模式下不會凍結。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使內建和 USB 鏡頭在背景模式下不會卡住。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使內置及USB鏡頭不會在背景模式中凍結"
